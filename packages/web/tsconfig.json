{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "composite": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true
  },
  "include": [
    "src/**/*.ts", "src/**/*.tsx", "vite-env.d.ts",
    "src/atlas/content/manifest.json", "src/atlas/content/data/*.json", "src/atlas/content/content/*.json",
    "src/atlas/content/implementation/*.json"
  ]
}
