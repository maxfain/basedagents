diff --git a/pipeline/src/agents.ts b/pipeline/src/agents.ts
new file mode 100644
index 0000000..beff013
--- /dev/null
+++ b/pipeline/src/agents.ts
@@ -0,0 +1,196 @@
+// Agent identification. Every matched signal is stored on the flight
+// (signals[]), never just the label, so a page can always say *why* a PR is
+// attributed to an agent — and so the "verify" signatures from the brief can
+// be audited against live PRs before they are trusted.
+//
+// Confidence ladder (brief, Pipeline step 5):
+//   high   — two or more signals
+//   medium — exactly one signal that is a bot author or a commit trailer /
+//            co-author line (attribution the agent itself writes)
+//   low    — a branch prefix alone (a human can name a branch anything)
+//   dataset— rows taken from AIDev on the paper's identification, before any
+//            re-verification of our own.
+
+export const AGENT_SLUGS = [
+  'openai-codex',
+  'github-copilot',
+  'devin',
+  'cursor',
+  'claude-code',
+] as const;
+
+export type AgentSlug = (typeof AGENT_SLUGS)[number] | 'unknown';
+
+export const AGENT_LABELS: Record<string, string> = {
+  'openai-codex': 'OpenAI Codex',
+  'github-copilot': 'GitHub Copilot',
+  devin: 'Devin',
+  cursor: 'Cursor',
+  'claude-code': 'Claude Code',
+  unknown: 'Unknown agent',
+};
+
+/** AIDev's agent column values → our slugs. */
+const AIDEV_AGENTS: Record<string, AgentSlug> = {
+  OpenAI_Codex: 'openai-codex',
+  Copilot: 'github-copilot',
+  Devin: 'devin',
+  Cursor: 'cursor',
+  Claude_Code: 'claude-code',
+};
+
+export function aidevAgentToSlug(value: string): AgentSlug {
+  return AIDEV_AGENTS[value] ?? 'unknown';
+}
+
+export type SignalInput = {
+  authorLogin?: string | null;
+  headRef?: string | null;
+  /** Commit messages (trailers live here). */
+  commitMessages?: string[];
+  /** Co-author names/logins parsed from commits, lowercased. */
+  coAuthors?: string[];
+};
+
+export type Detection = {
+  agent: AgentSlug;
+  signals: string[];
+  confidence: 'high' | 'medium' | 'low';
+};
+
+const BOT_AUTHORS: Record<string, AgentSlug> = {
+  'devin-ai-integration[bot]': 'devin', // confirmed by the AIDev paper
+  copilot: 'github-copilot', // login "Copilot" — verify against live PRs
+  'copilot-swe-agent[bot]': 'github-copilot',
+  'claude[bot]': 'claude-code', // the GitHub Action author
+};
+
+const BRANCH_PREFIXES: Record<string, AgentSlug> = {
+  'copilot/': 'github-copilot', // confirmed by the AIDev paper
+  'claude/': 'claude-code',
+  'cursor/': 'cursor', // verify
+  'codex/': 'openai-codex', // heuristic only — Codex adds no attribution
+};
+
+const CLAUDE_TRAILER = /co-authored-by:\s*claude\s*<noreply@anthropic\.com>/i;
+const CURSOR_COAUTHOR = /co-authored-by:\s*cursor\s*agent/i;
+const COPILOT_COAUTHOR = /co-authored-by:[^\n<]*copilot-swe-agent\[bot\]/i;
+
+/** A signal counts as "strong" when the agent wrote it itself. */
+const STRONG_PREFIX = /^(author:|trailer:|coauthor:)/;
+
+export function detectSignals(input: SignalInput): Detection | null {
+  const signals: string[] = [];
+  const votes = new Map<AgentSlug, number>();
+  const vote = (agent: AgentSlug, signal: string) => {
+    signals.push(signal);
+    votes.set(agent, (votes.get(agent) ?? 0) + 1);
+  };
+
+  const login = (input.authorLogin ?? '').toLowerCase();
+  if (login && BOT_AUTHORS[login]) vote(BOT_AUTHORS[login], `author:${login}`);
+
+  const ref = input.headRef ?? '';
+  for (const [prefix, agent] of Object.entries(BRANCH_PREFIXES)) {
+    if (ref.toLowerCase().startsWith(prefix)) vote(agent, `branch:${prefix}`);
+  }
+
+  const messages = input.commitMessages ?? [];
+  let sawClaudeTrailer = false;
+  let sawCursor = false;
+  let sawCopilot = false;
+  for (const message of messages) {
+    if (!sawClaudeTrailer && CLAUDE_TRAILER.test(message)) {
+      sawClaudeTrailer = true;
+      vote('claude-code', 'trailer:claude');
+    }
+    if (!sawCursor && CURSOR_COAUTHOR.test(message)) {
+      sawCursor = true;
+      vote('cursor', 'coauthor:cursor-agent');
+    }
+    if (!sawCopilot && COPILOT_COAUTHOR.test(message)) {
+      sawCopilot = true;
+      vote('github-copilot', 'coauthor:copilot-swe-agent[bot]');
+    }
+  }
+  for (const co of input.coAuthors ?? []) {
+    if (co.includes('cursor') && !sawCursor) {
+      sawCursor = true;
+      vote('cursor', 'coauthor:cursor-agent');
+    }
+  }
+
+  if (signals.length === 0) return null; // a PR with no signal is not a flight
+
+  // The agent with the most signals wins; ties go to the stronger signal set.
+  let best: AgentSlug = 'unknown';
+  let bestScore = -1;
+  for (const [agent, n] of votes) {
+    const strong = signals.filter(
+      (s) => STRONG_PREFIX.test(s) && signalAgent(s) === agent,
+    ).length;
+    const score = n * 10 + strong;
+    if (score > bestScore) {
+      best = agent;
+      bestScore = score;
+    }
+  }
+
+  const agentSignals = signals.filter((s) => signalAgent(s) === best);
+  const strongCount = agentSignals.filter((s) => STRONG_PREFIX.test(s)).length;
+  const confidence: Detection['confidence'] =
+    agentSignals.length >= 2 ? 'high' : strongCount >= 1 ? 'medium' : 'low';
+  return { agent: best, signals, confidence };
+}
+
+/** Signals present in a single commit message (trailers / co-author lines). */
+export function signalsFromCommitMessage(message: string): string[] {
+  const out: string[] = [];
+  if (CLAUDE_TRAILER.test(message)) out.push('trailer:claude');
+  if (CURSOR_COAUTHOR.test(message)) out.push('coauthor:cursor-agent');
+  if (COPILOT_COAUTHOR.test(message)) out.push('coauthor:copilot-swe-agent[bot]');
+  return out;
+}
+
+/** Which agent a stored signal string points at (for audits and tie-breaks). */
+export function signalAgent(signal: string): AgentSlug {
+  if (signal.startsWith('aidev:')) return aidevAgentToSlug(signal.slice(6));
+  if (signal === 'trailer:claude' || signal === 'author:claude[bot]' || signal === 'branch:claude/')
+    return 'claude-code';
+  if (signal === 'coauthor:cursor-agent' || signal === 'branch:cursor/') return 'cursor';
+  if (
+    signal === 'author:copilot' ||
+    signal === 'author:copilot-swe-agent[bot]' ||
+    signal === 'coauthor:copilot-swe-agent[bot]' ||
+    signal === 'branch:copilot/'
+  )
+    return 'github-copilot';
+  if (signal === 'author:devin-ai-integration[bot]') return 'devin';
+  if (signal === 'branch:codex/') return 'openai-codex';
+  return 'unknown';
+}
+
+/** GitHub avatar URL from the numeric user id — no API call, no email. */
+export function avatarUrl(githubUserId: number | bigint): string {
+  return `https://avatars.githubusercontent.com/u/${githubUserId}?v=4`;
+}
+
+// Machine accounts that GitHub types as "User" (no [bot] suffix) still flood
+// review threads; the common CI/review bots are named here so a reviewer
+// excerpt is a human's words. Conservative on purpose — the publish spot
+// check catches stragglers.
+const MACHINE_LOGINS = new Set([
+  'copilot', 'k8s-ci-robot', 'codecov', 'codecov-commenter', 'coderabbitai',
+  'sonarcloud', 'netlify', 'vercel', 'github-actions', 'dependabot',
+  'renovate-bot', 'greenkeeper', 'mergify', 'stale', 'cla-assistant',
+]);
+
+export function isBotLogin(login: string): boolean {
+  const lower = login.toLowerCase();
+  return (
+    lower.endsWith('[bot]') ||
+    lower.endsWith('-robot') ||
+    lower.endsWith('-ci-bot') ||
+    MACHINE_LOGINS.has(lower)
+  );
+}
diff --git a/pipeline/src/bigquery.ts b/pipeline/src/bigquery.ts
new file mode 100644
index 0000000..dd9a83c
--- /dev/null
+++ b/pipeline/src/bigquery.ts
@@ -0,0 +1,153 @@
+// BigQuery over REST with a service account — no Google SDK. The only use is
+// one query per day over one GH Archive day table, selecting only the columns
+// used (billed per byte scanned; never SELECT * on month tables).
+//
+// Auth: standard service-account JWT bearer flow, signed with node:crypto.
+// BQ_SERVICE_ACCOUNT_JSON holds the service account key JSON (client_email,
+// private_key, project_id).
+
+import { createSign } from 'node:crypto';
+
+type ServiceAccount = { client_email: string; private_key: string; project_id: string };
+
+export function parseServiceAccount(json: string): ServiceAccount {
+  const sa = JSON.parse(json) as Partial<ServiceAccount>;
+  if (!sa.client_email || !sa.private_key || !sa.project_id) {
+    throw new Error('BQ_SERVICE_ACCOUNT_JSON must contain client_email, private_key, project_id');
+  }
+  return sa as ServiceAccount;
+}
+
+const b64url = (s: string | Buffer) =>
+  Buffer.from(s).toString('base64').replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
+
+export function buildJwt(sa: ServiceAccount, nowSecs = Math.floor(Date.now() / 1000)): string {
+  const header = b64url(JSON.stringify({ alg: 'RS256', typ: 'JWT' }));
+  const claims = b64url(
+    JSON.stringify({
+      iss: sa.client_email,
+      scope: 'https://www.googleapis.com/auth/bigquery.readonly',
+      aud: 'https://oauth2.googleapis.com/token',
+      iat: nowSecs,
+      exp: nowSecs + 3600,
+    }),
+  );
+  const signer = createSign('RSA-SHA256');
+  signer.update(`${header}.${claims}`);
+  const signature = signer.sign(sa.private_key);
+  return `${header}.${claims}.${b64url(signature)}`;
+}
+
+async function accessToken(sa: ServiceAccount): Promise<string> {
+  const res = await fetch('https://oauth2.googleapis.com/token', {
+    method: 'POST',
+    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
+    body: new URLSearchParams({
+      grant_type: 'urn:ietf:params:oauth:grant-type:jwt-bearer',
+      assertion: buildJwt(sa),
+    }),
+  });
+  if (!res.ok) throw new Error(`token exchange failed: ${res.status} ${await res.text()}`);
+  const body = (await res.json()) as { access_token: string };
+  return body.access_token;
+}
+
+export type BqRow = Record<string, string | null>;
+
+/** Run a query; returns flat rows keyed by column name (all values strings). */
+export async function bigquery(
+  saJson: string,
+  sql: string,
+  { maxResults = 50_000, timeoutMs = 120_000 } = {},
+): Promise<{ rows: BqRow[]; bytesProcessed: number }> {
+  const sa = parseServiceAccount(saJson);
+  const token = await accessToken(sa);
+  const url = `https://bigquery.googleapis.com/bigquery/v2/projects/${sa.project_id}/queries`;
+  const res = await fetch(url, {
+    method: 'POST',
+    headers: { Authorization: `Bearer ${token}`, 'Content-Type': 'application/json' },
+    body: JSON.stringify({ query: sql, useLegacySql: false, maxResults, timeoutMs }),
+  });
+  if (!res.ok) throw new Error(`bigquery query failed: ${res.status} ${await res.text()}`);
+  type QueryResponse = {
+    jobComplete?: boolean;
+    totalBytesProcessed?: string;
+    schema?: { fields: { name: string }[] };
+    rows?: { f: { v: unknown }[] }[];
+    pageToken?: string;
+    jobReference?: { jobId: string; location?: string };
+  };
+  let body = (await res.json()) as QueryResponse;
+  if (!body.jobComplete) throw new Error('bigquery job did not complete within timeoutMs');
+
+  const fields = body.schema?.fields.map((f) => f.name) ?? [];
+  const rows: BqRow[] = [];
+  const collect = (page: QueryResponse) => {
+    for (const r of page.rows ?? []) {
+      const row: BqRow = {};
+      r.f.forEach((cell, i) => {
+        row[fields[i]] = cell.v === null || cell.v === undefined ? null : String(cell.v);
+      });
+      rows.push(row);
+    }
+  };
+  collect(body);
+  while (body.pageToken && body.jobReference) {
+    const pageUrl = new URL(
+      `https://bigquery.googleapis.com/bigquery/v2/projects/${sa.project_id}/queries/${body.jobReference.jobId}`,
+    );
+    pageUrl.searchParams.set('pageToken', body.pageToken);
+    pageUrl.searchParams.set('maxResults', String(maxResults));
+    if (body.jobReference.location) pageUrl.searchParams.set('location', body.jobReference.location);
+    const pageRes = await fetch(pageUrl, { headers: { Authorization: `Bearer ${token}` } });
+    if (!pageRes.ok) throw new Error(`bigquery page failed: ${pageRes.status}`);
+    const page = (await pageRes.json()) as QueryResponse;
+    collect(page);
+    body.pageToken = page.pageToken;
+  }
+  return { rows, bytesProcessed: Number(body.totalBytesProcessed ?? 0) };
+}
+
+/**
+ * The daily discovery query (brief, Pipeline step 4): opened PRs whose author
+ * is a known bot login, whose head ref starts with an agent prefix, or whose
+ * branch received a push with a co-author trailer naming an agent — plus
+ * closed events for state updates. One day table, only the columns used.
+ */
+export function discoverySql(dateYYYYMMDD: string): string {
+  if (!/^\d{8}$/.test(dateYYYYMMDD)) throw new Error(`bad date: ${dateYYYYMMDD}`);
+  const table = `\`githubarchive.day.${dateYYYYMMDD}\``;
+  return `
+WITH prs AS (
+  SELECT repo.name AS repo,
+         JSON_VALUE(payload, '$.pull_request.number') AS number,
+         JSON_VALUE(payload, '$.pull_request.id') AS pr_id,
+         JSON_VALUE(payload, '$.pull_request.user.login') AS login,
+         JSON_VALUE(payload, '$.pull_request.user.id') AS user_id,
+         JSON_VALUE(payload, '$.pull_request.head.ref') AS head_ref,
+         JSON_VALUE(payload, '$.pull_request.merged') AS merged,
+         JSON_VALUE(payload, '$.action') AS action,
+         created_at
+  FROM ${table}
+  WHERE type = 'PullRequestEvent'
+),
+pushes AS (
+  SELECT DISTINCT repo.name AS repo,
+         REGEXP_REPLACE(JSON_VALUE(payload, '$.ref'), '^refs/heads/', '') AS head_ref
+  FROM ${table}, UNNEST(JSON_QUERY_ARRAY(payload, '$.commits')) AS c
+  WHERE type = 'PushEvent'
+    AND REGEXP_CONTAINS(JSON_VALUE(c, '$.message'), r'(?i)co-authored-by:.*(claude|cursor|copilot)')
+),
+agentish AS (
+  SELECT p.*, (u.repo IS NOT NULL) AS coauthor_push
+  FROM prs p LEFT JOIN pushes u USING (repo, head_ref)
+  WHERE p.login IN ('devin-ai-integration[bot]', 'Copilot', 'claude[bot]')
+     OR REGEXP_CONTAINS(p.head_ref, r'^(copilot|claude|cursor|codex)/')
+     OR u.repo IS NOT NULL
+)
+SELECT repo, number, pr_id, login, user_id, head_ref, action, merged, coauthor_push,
+       CAST(created_at AS STRING) AS created_at
+FROM agentish
+WHERE action IN ('opened', 'closed', 'reopened')
+ORDER BY repo, number, created_at`.trim();
+}
diff --git a/pipeline/src/classify.ts b/pipeline/src/classify.ts
new file mode 100644
index 0000000..3789194
--- /dev/null
+++ b/pipeline/src/classify.ts
@@ -0,0 +1,94 @@
+// Outcome classification — deterministic, no LLM (brief, Pipeline step 6).
+//
+//   merged_clean        merged, no changes requested, one review round
+//   merged_after_rework merged after ≥1 changes-requested review, or ≥2
+//                       commits pushed after the first review
+//   burn                closed unmerged with ≥1 review or comment from a
+//                       human who is not the author
+//   abandoned           closed unmerged with no human engagement
+//   open                open under 30 days
+//   stale               open 30 days or more
+//
+// Every input is a stored field on the flight, so a re-run needs no re-fetch.
+
+export type Outcome =
+  | 'merged_clean'
+  | 'merged_after_rework'
+  | 'burn'
+  | 'abandoned'
+  | 'open'
+  | 'stale';
+
+export type ClassifyInput = {
+  state: 'open' | 'merged' | 'closed';
+  openedAt: string | null;
+  changeRequests: number;
+  humanReviewCount: number;
+  humanCommentCount: number;
+  commitsAfterFirstReview: number;
+};
+
+export const STALE_DAYS = 30;
+
+export function classifyOutcome(input: ClassifyInput, now = new Date()): Outcome {
+  if (input.state === 'merged') {
+    const reworked = input.changeRequests >= 1 || input.commitsAfterFirstReview >= 2;
+    return reworked ? 'merged_after_rework' : 'merged_clean';
+  }
+  if (input.state === 'closed') {
+    const humanEngaged = input.humanReviewCount >= 1 || input.humanCommentCount >= 1;
+    return humanEngaged ? 'burn' : 'abandoned';
+  }
+  const opened = input.openedAt ? Date.parse(input.openedAt) : NaN;
+  if (Number.isFinite(opened)) {
+    const ageDays = (now.getTime() - opened) / 86_400_000;
+    if (ageDays >= STALE_DAYS) return 'stale';
+  }
+  return 'open';
+}
+
+export type ExcerptCandidate = {
+  kind: 'review' | 'comment';
+  /** Review verdict, uppercased GitHub state; comments have none. */
+  state?: string | null;
+  authorLogin: string | null;
+  authorIsBot: boolean;
+  body: string | null;
+  createdAt: string | null;
+  url: string | null;
+};
+
+/**
+ * The reviewer excerpt for burns and rework: the earliest changes-requested
+ * review, else the earliest comment or review by a non-author human — first
+ * 25 words, verbatim, with its URL (brief, Pipeline step 6).
+ */
+export function pickReviewerExcerpt(
+  candidates: ExcerptCandidate[],
+  prAuthorLogin: string | null,
+  firstWords: (text: string, n?: number) => string,
+): { excerpt: string; url: string | null } | null {
+  const author = (prAuthorLogin ?? '').toLowerCase();
+  const withBody = candidates.filter(
+    (c) => c.body && c.body.trim().length > 0 && (c.authorLogin ?? '').toLowerCase() !== author,
+  );
+  const byTime = (a: ExcerptCandidate, b: ExcerptCandidate) =>
+    (a.createdAt ?? '').localeCompare(b.createdAt ?? '');
+
+  const changesRequested = withBody
+    .filter((c) => c.kind === 'review' && (c.state ?? '').toUpperCase() === 'CHANGES_REQUESTED')
+    .sort(byTime);
+  const humans = withBody.filter((c) => !c.authorIsBot).sort(byTime);
+
+  const pick = changesRequested[0] ?? humans[0];
+  if (!pick?.body) return null;
+  // ≤25 words, verbatim. Degenerate "words" (minified code, long URLs) are
+  // dropped from the tail until the excerpt fits the stored bound; a single
+  // monster token yields no excerpt rather than a mangled one.
+  let excerpt = firstWords(pick.body, 25);
+  while (excerpt.length > 700 && excerpt.includes(' ')) {
+    excerpt = excerpt.slice(0, excerpt.lastIndexOf(' '));
+  }
+  if (excerpt.length === 0 || excerpt.length > 700) return null;
+  return { excerpt, url: pick.url ?? null };
+}
diff --git a/pipeline/src/db.ts b/pipeline/src/db.ts
new file mode 100644
index 0000000..b696cc5
--- /dev/null
+++ b/pipeline/src/db.ts
@@ -0,0 +1,101 @@
+// One thin interface over two drivers: postgres.js against the real database
+// (DATABASE_URL=postgres://…) and PGlite for tests (DATABASE_URL=pglite://
+// or a PGlite instance passed directly). Parameterized text queries only —
+// no ORM, no query builder — so every statement is readable in place.
+
+import { readFile, readdir } from 'node:fs/promises';
+import { join } from 'node:path';
+
+export type Db = {
+  query<T = Record<string, unknown>>(text: string, params?: unknown[]): Promise<T[]>;
+  end(): Promise<void>;
+};
+
+export async function connect(url = process.env.DATABASE_URL ?? ''): Promise<Db> {
+  if (!url) throw new Error('DATABASE_URL is not set');
+  if (url.startsWith('pglite://')) {
+    const { PGlite } = await import('@electric-sql/pglite');
+    const target = url.slice('pglite://'.length);
+    const pg = new PGlite(target === 'memory' || target === '' ? undefined : target);
+    return wrapPglite(pg);
+  }
+  const { default: postgres } = await import('postgres');
+  // Supabase poolers and direct connections both work; keep the pool tiny —
+  // the pipeline is a batch client, not a server.
+  const sql = postgres(url, { max: 4, prepare: false });
+  return {
+    async query<T>(text: string, params: unknown[] = []): Promise<T[]> {
+      const rows = await sql.unsafe(text, params as never[]);
+      return rows as unknown as T[];
+    },
+    async end() {
+      await sql.end({ timeout: 5 });
+    },
+  };
+}
+
+/** Wrap an existing PGlite instance (tests construct their own). */
+export function wrapPglite(pg: {
+  query: (q: string, params?: unknown[]) => Promise<{ rows: unknown[] }>;
+  exec: (q: string) => Promise<{ rows: unknown[] }[]>;
+  close: () => Promise<void>;
+}): Db {
+  return {
+    async query<T>(text: string, params: unknown[] = []): Promise<T[]> {
+      // PGlite's extended-protocol query() takes exactly one statement;
+      // parameterless multi-statement SQL (migrations) goes through exec().
+      if (params.length === 0) {
+        const results = await pg.exec(text);
+        return (results.at(-1)?.rows ?? []) as T[];
+      }
+      const res = await pg.query(text, params);
+      return res.rows as T[];
+    },
+    async end() {
+      await pg.close();
+    },
+  };
+}
+
+/**
+ * Multi-row INSERT in batches. `conflict` is the full ON CONFLICT clause
+ * ("on conflict (x) do nothing" / "… do update set …"). Returns rows written
+ * (as reported by RETURNING 1 when `returning` is true, else rows attempted).
+ */
+export async function insertBatch(
+  db: Db,
+  table: string,
+  columns: string[],
+  rows: unknown[][],
+  conflict = '',
+  batchSize = 500,
+): Promise<number> {
+  let written = 0;
+  for (let i = 0; i < rows.length; i += batchSize) {
+    const batch = rows.slice(i, i + batchSize);
+    const params: unknown[] = [];
+    const tuples = batch
+      .map((row) => {
+        const placeholders = row.map((v) => {
+          params.push(v);
+          return `$${params.length}`;
+        });
+        return `(${placeholders.join(',')})`;
+      })
+      .join(',');
+    const text = `insert into ${table} (${columns.join(',')}) values ${tuples} ${conflict} returning 1`;
+    const out = await db.query(text, params);
+    written += out.length;
+  }
+  return written;
+}
+
+/** Apply pipeline/migrations/*.sql in filename order (idempotent files). */
+export async function migrate(db: Db, dir: string): Promise<string[]> {
+  const files = (await readdir(dir)).filter((f) => f.endsWith('.sql')).sort();
+  for (const f of files) {
+    const sql = await readFile(join(dir, f), 'utf8');
+    await db.query(sql);
+  }
+  return files;
+}
diff --git a/pipeline/src/debrief.ts b/pipeline/src/debrief.ts
new file mode 100644
index 0000000..4e6a3ed
--- /dev/null
+++ b/pipeline/src/debrief.ts
@@ -0,0 +1,190 @@
+// The debrief: 40–60 words, present tense, AgentRiders voice — task, what
+// happened, outcome. Enforced by validation, not by prompt alone (brief,
+// Quality): numbers must match stored fields, quoted words must be a
+// substring of reviewer_excerpt, no motive, no sentiment, no advice, no
+// exclamation marks, no emoji. Reject and retry once, then leave the debrief
+// empty and let the page render without it.
+
+import Anthropic from '@anthropic-ai/sdk';
+import { wordCount } from './text.ts';
+
+export const DEBRIEF_PROMPT_VERSION = 'v1';
+
+/** The structured record the model sees. Never the diff, never the full body. */
+export type DebriefRecord = {
+  title: string;
+  body_excerpt: string | null;
+  agent_label: string;
+  repo: string;
+  task_type: string | null;
+  outcome: string;
+  state: string;
+  additions: number | null;
+  deletions: number | null;
+  files_changed: number | null;
+  commits: number | null;
+  review_count: number | null;
+  change_requests: number | null;
+  review_comment_count: number | null;
+  hours_to_merge: number | null;
+  reviewer_excerpt: string | null;
+};
+
+const OUTCOME_PHRASES: Record<string, string> = {
+  merged_clean: 'merged clean — no changes requested, one review round',
+  merged_after_rework: 'merged after rework',
+  burn: 'a burn — closed unmerged after human review',
+  abandoned: 'abandoned — closed unmerged with no human engagement',
+  open: 'still open',
+  stale: 'open and stale (30+ days)',
+};
+
+export function buildDebriefPrompt(record: DebriefRecord): { system: string; user: string } {
+  const system = [
+    'You write flight debriefs for AgentRiders, a public log of AI coding-agent pull requests.',
+    'Voice: a calm flight-log entry. Present tense. Plain, concrete, no hype.',
+    'Guild vocabulary where it fits naturally (a failed flight is a burn; the human is the rider) and plain English where it does not.',
+    'Hard rules:',
+    '- 40 to 60 words, one paragraph: the task, what happened, the outcome.',
+    '- Facts ONLY from the record you are given. Never guess or embellish.',
+    '- Use a number only if it appears in the record fields, and copy it exactly.',
+    '- Never speculate about motive or feeling. Phrases like "the agent decided" or "the reviewer felt" are forbidden.',
+    '- No advice, no judgment, no exclamation marks, no emoji, no markdown.',
+    '- If you quote the reviewer, quote the reviewer_excerpt verbatim (a contiguous span, in double quotes) and nothing else. Quoting is optional.',
+    'Reply with the debrief text alone.',
+  ].join('\n');
+  const user = `Write the debrief for this flight record:\n${JSON.stringify(
+    {
+      ...record,
+      outcome: `${record.outcome} (${OUTCOME_PHRASES[record.outcome] ?? record.outcome})`,
+    },
+    null,
+    1,
+  )}`;
+  return { system, user };
+}
+
+// --- validation --------------------------------------------------------------
+
+const BANNED = /\b(?:agent|reviewer|author|model|rider)s?\s+(?:decided|decides|felt|feels|wanted|wants|hoped|hopes|believed|believes|thought|thinks|intended|intends|chose|tried)\b/i;
+const EMOJI = /\p{Extended_Pictographic}/u;
+const NUMBER = /\d+(?:\.\d+)?/g;
+
+/** Spans inside double quotes (straight or curly). */
+function quotedSpans(text: string): string[] {
+  const spans: string[] = [];
+  for (const m of text.matchAll(/["“”]([^"“”]+)["“”]/g)) spans.push(m[1]);
+  return spans;
+}
+
+function allowedNumbers(record: DebriefRecord): Set<string> {
+  const allowed = new Set<string>();
+  const add = (v: number | null) => {
+    if (v === null || v === undefined) return;
+    allowed.add(String(v));
+    if (!Number.isInteger(v)) {
+      allowed.add(v.toFixed(1));
+      allowed.add(String(Math.round(v)));
+      allowed.add(String(Math.floor(v)));
+    }
+  };
+  add(record.additions);
+  add(record.deletions);
+  add(record.files_changed);
+  add(record.commits);
+  add(record.review_count);
+  add(record.change_requests);
+  add(record.review_comment_count);
+  add(record.hours_to_merge);
+  if (record.hours_to_merge !== null && record.hours_to_merge >= 24) {
+    add(Math.round((record.hours_to_merge / 24) * 10) / 10); // days form
+    add(Math.round(record.hours_to_merge / 24));
+  }
+  // Numbers the title itself carries (issue numbers, version strings) are part
+  // of the record; numbers in the reviewer excerpt are covered by the quote rule.
+  for (const m of record.title.matchAll(NUMBER)) allowed.add(m[0]);
+  return allowed;
+}
+
+export type DebriefValidation = { ok: true } | { ok: false; reasons: string[] };
+
+export function validateDebrief(text: string, record: DebriefRecord): DebriefValidation {
+  const reasons: string[] = [];
+  const trimmed = text.trim();
+  const words = wordCount(trimmed);
+  if (words < 40 || words > 60) reasons.push(`word count ${words} outside 40–60`);
+  if (trimmed.includes('!')) reasons.push('contains an exclamation mark');
+  if (EMOJI.test(trimmed)) reasons.push('contains emoji');
+  // Markdown markers — but a bare "#4821" issue reference is record language,
+  // and single underscores appear in code identifiers.
+  if (/[*`\[\]]|__|(^|\n)#\s/.test(trimmed)) reasons.push('contains markdown');
+
+  const quotes = quotedSpans(trimmed);
+  const excerpt = record.reviewer_excerpt ?? '';
+  for (const q of quotes) {
+    if (!excerpt.includes(q)) reasons.push(`quoted words not in reviewer_excerpt: "${q.slice(0, 60)}"`);
+  }
+
+  // Banned motive/sentiment phrasing — checked outside verbatim quotes.
+  let unquoted = trimmed;
+  for (const q of quotes) unquoted = unquoted.split(q).join(' ');
+  if (BANNED.test(unquoted)) reasons.push('speculates about motive or feeling');
+
+  const allowed = allowedNumbers(record);
+  for (const q of quotes) if (excerpt.includes(q)) allowed.add('__quoted__'); // marker only
+  let numberScope = trimmed;
+  for (const q of quotes) if (excerpt.includes(q)) numberScope = numberScope.split(q).join(' ');
+  for (const m of numberScope.matchAll(NUMBER)) {
+    if (!allowed.has(m[0])) reasons.push(`number ${m[0]} not in the record fields`);
+  }
+
+  return reasons.length === 0 ? { ok: true } : { ok: false, reasons };
+}
+
+// --- generation ---------------------------------------------------------------
+
+// claude-haiku-5-5 cuts the ~20k-call backfill cost roughly 40× and this task
+// is narrow and machine-validated, but the model stays the operator's choice:
+// set DEBRIEF_MODEL to change it.
+export const DEFAULT_DEBRIEF_MODEL = 'claude-opus-5-5';
+
+export type DebriefResult =
+  | { ok: true; text: string }
+  | { ok: false; attempts: string[]; reasons: string[] };
+
+export async function generateDebrief(
+  client: Anthropic,
+  record: DebriefRecord,
+  model = process.env.DEBRIEF_MODEL || DEFAULT_DEBRIEF_MODEL,
+): Promise<DebriefResult> {
+  const { system, user } = buildDebriefPrompt(record);
+  const attempts: string[] = [];
+  let lastReasons: string[] = [];
+  for (let attempt = 0; attempt < 2; attempt++) {
+    const messages: Anthropic.MessageParam[] = [{ role: 'user', content: user }];
+    if (attempt > 0 && attempts[0]) {
+      messages.push({ role: 'assistant', content: attempts[0] });
+      messages.push({
+        role: 'user',
+        content: `That debrief failed validation: ${lastReasons.join('; ')}. Rewrite it following every hard rule.`,
+      });
+    }
+    const response = await client.messages.create({
+      model,
+      max_tokens: 2000,
+      system,
+      output_config: { effort: 'low' },
+      messages,
+    });
+    const text = response.content
+      .filter((b): b is Anthropic.TextBlock => b.type === 'text')
+      .map((b) => b.text)
+      .join('')
+      .trim();
+    attempts.push(text);
+    const verdict = validateDebrief(text, record);
+    if (verdict.ok) return { ok: true, text };
+    lastReasons = verdict.reasons;
+  }
+  return { ok: false, attempts, reasons: lastReasons };
+}
