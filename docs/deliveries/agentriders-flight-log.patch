@@ -0,0 +1,20 @@
+// Environment access with named failures. Secrets come from the environment
+// only (GitHub Actions secrets in CI, a local .env sourced by the shell in
+// dev) — never from files in the repo.
+
+export function required(name: string): string {
+  const v = process.env[name];
+  if (!v) throw new Error(`Missing required environment variable ${name}`);
+  return v;
+}
+
+export function optional(name: string, fallback = ''): string {
+  return process.env[name] ?? fallback;
+}
+
+export function intEnv(name: string, fallback: number): number {
+  const v = process.env[name];
+  const n = v === undefined ? fallback : Number(v);
+  if (!Number.isFinite(n)) throw new Error(`${name} must be a number, got "${v}"`);
+  return n;
+}
diff --git a/pipeline/src/github-graphql.ts b/pipeline/src/github-graphql.ts
new file mode 100644
index 0000000..4ee54c4
--- /dev/null
+++ b/pipeline/src/github-graphql.ts
@@ -0,0 +1,309 @@
+// GitHub GraphQL batching: 20–50 PRs per query via aliases, one fragment, a
+// rateLimit read on every response (sleep to resetAt under 200 points), and a
+// 15-minute pause after three consecutive 5xx responses (brief, Rate limits).
+
+export type PrRef = { owner: string; name: string; number: number };
+
+const PR_FRAGMENT = `
+fragment PrFields on PullRequest {
+  fullDatabaseId
+  number
+  title
+  bodyText
+  state
+  merged
+  createdAt
+  mergedAt
+  closedAt
+  additions
+  deletions
+  changedFiles
+  headRefName
+  url
+  author {
+    __typename
+    login
+    ... on User { databaseId }
+    ... on Bot { databaseId }
+  }
+  commits(first: 100) {
+    totalCount
+    nodes { commit { message committedDate } }
+  }
+  reviews(first: 50) {
+    totalCount
+    nodes {
+      state
+      submittedAt
+      url
+      bodyText
+      author { __typename login }
+    }
+  }
+  reviewThreads(first: 50) {
+    nodes { comments(first: 5) { totalCount } }
+  }
+  comments(first: 50) {
+    totalCount
+    nodes { bodyText createdAt url author { __typename login } }
+  }
+  timelineItems(first: 100, itemTypes: [LABELED_EVENT, CLOSED_EVENT, MERGED_EVENT]) {
+    nodes {
+      __typename
+      ... on LabeledEvent { createdAt actor { login } label { name } }
+      ... on ClosedEvent { createdAt actor { login } url }
+      ... on MergedEvent { createdAt actor { login } url }
+    }
+  }
+  repository {
+    databaseId
+    nameWithOwner
+    stargazerCount
+    isFork
+    primaryLanguage { name }
+    licenseInfo { spdxId }
+  }
+}`;
+
+export function buildPrBatchQuery(refs: PrRef[]): string {
+  const parts = refs.map(
+    (r, i) =>
+      `p${i}: repository(owner: ${JSON.stringify(r.owner)}, name: ${JSON.stringify(r.name)}) {` +
+      ` pullRequest(number: ${Math.trunc(r.number)}) { ...PrFields } }`,
+  );
+  return `query {\n${parts.join('\n')}\nrateLimit { remaining resetAt cost }\n}\n${PR_FRAGMENT}`;
+}
+
+export function buildRepoBatchQuery(repos: { owner: string; name: string }[]): string {
+  const parts = repos.map(
+    (r, i) =>
+      `r${i}: repository(owner: ${JSON.stringify(r.owner)}, name: ${JSON.stringify(r.name)}) {` +
+      ` databaseId nameWithOwner stargazerCount isFork primaryLanguage { name } licenseInfo { spdxId } }`,
+  );
+  return `query {\n${parts.join('\n')}\nrateLimit { remaining resetAt cost }\n}`;
+}
+
+export type GraphqlResult = {
+  data?: Record<string, unknown> & {
+    rateLimit?: { remaining: number; resetAt: string; cost: number };
+  };
+  errors?: { message: string; path?: (string | number)[]; type?: string }[];
+};
+
+export type GraphqlClientOptions = {
+  token: string;
+  fetchImpl?: typeof fetch;
+  sleep?: (ms: number) => Promise<void>;
+  lowWater?: number;
+  pauseMs?: number;
+  userAgent?: string;
+};
+
+const defaultSleep = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));
+
+export class GraphqlClient {
+  #opts: Required<Omit<GraphqlClientOptions, 'token'>> & { token: string };
+  #consecutive5xx = 0;
+  lastRemaining: number | null = null;
+
+  constructor(opts: GraphqlClientOptions) {
+    this.#opts = {
+      token: opts.token,
+      fetchImpl: opts.fetchImpl ?? fetch,
+      sleep: opts.sleep ?? defaultSleep,
+      lowWater: opts.lowWater ?? 200,
+      pauseMs: opts.pauseMs ?? 15 * 60 * 1000,
+      userAgent: opts.userAgent ?? 'agentriders-flightlog',
+    };
+  }
+
+  async request(query: string): Promise<GraphqlResult> {
+    for (;;) {
+      const res = await this.#opts.fetchImpl('https://api.github.com/graphql', {
+        method: 'POST',
+        headers: {
+          Authorization: `Bearer ${this.#opts.token}`,
+          'Content-Type': 'application/json',
+          'User-Agent': this.#opts.userAgent,
+        },
+        body: JSON.stringify({ query }),
+      });
+      if (res.status >= 500) {
+        this.#consecutive5xx++;
+        if (this.#consecutive5xx >= 3) {
+          console.log(`  three consecutive 5xx — pausing ${this.#opts.pauseMs / 60000} min`);
+          await this.#opts.sleep(this.#opts.pauseMs);
+          this.#consecutive5xx = 0;
+        } else {
+          await this.#opts.sleep(2000 * this.#consecutive5xx);
+        }
+        continue;
+      }
+      this.#consecutive5xx = 0;
+      if (res.status === 403 || res.status === 429) {
+        // Secondary rate limit: honor Retry-After, else back off a minute.
+        const retryAfter = Number(res.headers.get('retry-after') ?? '60');
+        await this.#opts.sleep(Math.max(retryAfter, 10) * 1000);
+        continue;
+      }
+      if (!res.ok) throw new Error(`GraphQL HTTP ${res.status}: ${await res.text()}`);
+      const body = (await res.json()) as GraphqlResult;
+      const rl = body.data?.rateLimit;
+      if (rl) {
+        this.lastRemaining = rl.remaining;
+        if (rl.remaining < this.#opts.lowWater) {
+          const waitMs = Math.max(0, Date.parse(rl.resetAt) - Date.now()) + 5000;
+          console.log(`  rateLimit low (${rl.remaining}) — sleeping to resetAt (+5s)`);
+          await this.#opts.sleep(waitMs);
+        }
+      }
+      return body;
+    }
+  }
+}
+
+// --- parsing -----------------------------------------------------------------
+
+type AuthorNode = { __typename: string; login: string; databaseId?: number } | null;
+
+export type EnrichedPr = {
+  ghPrId: number | null;
+  number: number;
+  title: string;
+  bodyText: string;
+  state: 'open' | 'merged' | 'closed';
+  createdAt: string | null;
+  mergedAt: string | null;
+  closedAt: string | null;
+  additions: number;
+  deletions: number;
+  changedFiles: number;
+  headRefName: string;
+  authorLogin: string | null;
+  authorDatabaseId: number | null;
+  authorIsBot: boolean;
+  commitMessages: string[];
+  commitsTotal: number;
+  reviews: {
+    state: string;
+    submittedAt: string | null;
+    url: string | null;
+    body: string;
+    authorLogin: string | null;
+    authorIsBot: boolean;
+  }[];
+  reviewCommentCount: number;
+  comments: {
+    body: string;
+    createdAt: string | null;
+    url: string | null;
+    authorLogin: string | null;
+    authorIsBot: boolean;
+  }[];
+  timeline: { kind: string; at: string | null; actor: string | null; url: string | null }[];
+  repo: {
+    databaseId: number | null;
+    nameWithOwner: string | null;
+    stargazerCount: number | null;
+    isFork: boolean | null;
+    primaryLanguage: string | null;
+    license: string | null;
+  };
+  raw: unknown;
+};
+
+const isBotAuthor = (a: AuthorNode) =>
+  !!a && (a.__typename === 'Bot' || a.login.endsWith('[bot]') || a.login.toLowerCase() === 'copilot');
+
+export function parsePrNode(node: unknown): EnrichedPr | null {
+  const pr = (node as { pullRequest?: Record<string, unknown> } | null)?.pullRequest;
+  if (!pr) return null;
+  const author = pr.author as AuthorNode;
+  const commits = pr.commits as { totalCount: number; nodes: { commit: { message: string; committedDate: string } }[] };
+  const reviews = pr.reviews as {
+    totalCount: number;
+    nodes: { state: string; submittedAt: string | null; url: string | null; bodyText: string; author: AuthorNode }[];
+  };
+  const threads = pr.reviewThreads as { nodes: { comments: { totalCount: number } }[] };
+  const comments = pr.comments as {
+    totalCount: number;
+    nodes: { bodyText: string; createdAt: string | null; url: string | null; author: AuthorNode }[];
+  };
+  const timelineItems = pr.timelineItems as {
+    nodes: {
+      __typename: string;
+      createdAt?: string;
+      actor?: { login: string } | null;
+      url?: string;
+      label?: { name: string };
+    }[];
+  };
+  const repo = pr.repository as {
+    databaseId: number | null;
+    nameWithOwner: string;
+    stargazerCount: number;
+    isFork: boolean;
+    primaryLanguage: { name: string } | null;
+    licenseInfo: { spdxId: string } | null;
+  } | null;
+
+  const state = pr.merged ? 'merged' : String(pr.state) === 'OPEN' ? 'open' : 'closed';
+  const commitNodes = commits?.nodes ?? [];
+  const timeline = (timelineItems?.nodes ?? []).flatMap((t) => {
+    const kind =
+      t.__typename === 'LabeledEvent' ? 'labeled'
+      : t.__typename === 'ClosedEvent' ? 'closed'
+      : t.__typename === 'MergedEvent' ? 'merged'
+      : null;
+    return kind ? [{ kind, at: t.createdAt ?? null, actor: t.actor?.login ?? null, url: t.url ?? null }] : [];
+  });
+  for (const c of commitNodes) {
+    timeline.push({ kind: 'committed', at: c.commit.committedDate ?? null, actor: null, url: null });
+  }
+
+  return {
+    ghPrId: pr.fullDatabaseId ? Number(pr.fullDatabaseId) : null,
+    number: Number(pr.number),
+    title: String(pr.title ?? ''),
+    bodyText: String(pr.bodyText ?? ''),
+    state,
+    createdAt: (pr.createdAt as string) ?? null,
+    mergedAt: (pr.mergedAt as string) ?? null,
+    closedAt: (pr.closedAt as string) ?? null,
+    additions: Number(pr.additions ?? 0),
+    deletions: Number(pr.deletions ?? 0),
+    changedFiles: Number(pr.changedFiles ?? 0),
+    headRefName: String(pr.headRefName ?? ''),
+    authorLogin: author?.login ?? null,
+    authorDatabaseId: author?.databaseId ?? null,
+    authorIsBot: isBotAuthor(author),
+    commitMessages: commitNodes.map((c) => c.commit.message),
+    commitsTotal: Number(commits?.totalCount ?? commitNodes.length),
+    reviews: (reviews?.nodes ?? []).map((r) => ({
+      state: r.state,
+      submittedAt: r.submittedAt,
+      url: r.url,
+      body: r.bodyText ?? '',
+      authorLogin: r.author?.login ?? null,
+      authorIsBot: isBotAuthor(r.author),
+    })),
+    reviewCommentCount: (threads?.nodes ?? []).reduce((n, t) => n + (t.comments?.totalCount ?? 0), 0),
+    comments: (comments?.nodes ?? []).map((c) => ({
+      body: c.bodyText ?? '',
+      createdAt: c.createdAt,
+      url: c.url,
+      authorLogin: c.author?.login ?? null,
+      authorIsBot: isBotAuthor(c.author),
+    })),
+    timeline,
+    repo: {
+      databaseId: repo?.databaseId ?? null,
+      nameWithOwner: repo?.nameWithOwner ?? null,
+      stargazerCount: repo?.stargazerCount ?? null,
+      isFork: repo?.isFork ?? null,
+      primaryLanguage: repo?.primaryLanguage?.name ?? null,
+      license: repo?.licenseInfo?.spdxId ?? null,
+    },
+    raw: pr,
+  };
+}
diff --git a/pipeline/src/hf.ts b/pipeline/src/hf.ts
new file mode 100644
index 0000000..350b3d3
--- /dev/null
+++ b/pipeline/src/hf.ts
@@ -0,0 +1,54 @@
+// Hugging Face dataset download: plain HTTPS fetches of the parquet files at
+// a pinned revision — the Node equivalent of snapshot_download for the few
+// files we need. Re-runs skip files that already exist with the right size.
+
+import { createWriteStream } from 'node:fs';
+import { mkdir, stat } from 'node:fs/promises';
+import { join } from 'node:path';
+import { Readable } from 'node:stream';
+import { pipeline } from 'node:stream/promises';
+
+const DATASET = 'hao-li/AIDev';
+
+export const AIDEV_FILES = [
+  'all_pull_request.parquet',
+  'all_repository.parquet',
+  'all_user.parquet',
+  'pull_request.parquet',
+  'repository.parquet',
+  'user.parquet',
+  'pr_task_type.parquet',
+  'pr_reviews.parquet',
+  'pr_review_comments.parquet',
+  'pr_comments.parquet',
+  'pr_commits.parquet',
+  'pr_commit_details.parquet',
+  'pr_timeline.parquet',
+  'issue.parquet',
+  'related_issue.parquet',
+  'README.md',
+] as const;
+
+export async function downloadAidev(
+  dir: string,
+  revision = 'v3',
+  files: readonly string[] = AIDEV_FILES,
+): Promise<void> {
+  await mkdir(dir, { recursive: true });
+  for (const name of files) {
+    const dest = join(dir, name);
+    const url = `https://huggingface.co/datasets/${DATASET}/resolve/${revision}/${name}`;
+    const head = await fetch(url, { method: 'HEAD', redirect: 'follow' });
+    if (!head.ok) throw new Error(`HEAD ${url} -> ${head.status}`);
+    const expected = Number(head.headers.get('content-length') ?? '0');
+    const existing = await stat(dest).catch(() => null);
+    if (existing && expected > 0 && existing.size === expected) {
+      console.log(`  kept ${name} (${(expected / 1e6).toFixed(1)} MB)`);
+      continue;
+    }
+    const res = await fetch(url, { redirect: 'follow' });
+    if (!res.ok || !res.body) throw new Error(`GET ${url} -> ${res.status}`);
+    await pipeline(Readable.fromWeb(res.body as never), createWriteStream(dest));
+    console.log(`  downloaded ${name} (${(expected / 1e6).toFixed(1)} MB)`);
+  }
+}
diff --git a/pipeline/src/jobs/classify.ts b/pipeline/src/jobs/classify.ts
new file mode 100644
index 0000000..5fc35f8
--- /dev/null
+++ b/pipeline/src/jobs/classify.ts
@@ -0,0 +1,45 @@
+// Bulk outcome classification. Set-based SQL mirroring src/classify.ts
+// exactly (a unit test keeps the two in lockstep). Only flights whose
+// engagement fields are known (pop detail or enrichment) are classified —
+// a long-tail core row stays unclassified (and so unindexed) until a claim
+// triggers its enrichment.
+
+import type { Db } from '../db.ts';
+import { STALE_DAYS } from '../classify.ts';
+import { startRun, finishRun } from '../runlog.ts';
+
+export const CLASSIFY_SQL = `
+update flights set outcome = computed.outcome, classified_at = now()
+from (
+  select id, case
+    when state = 'merged' and (coalesce(change_requests,0) >= 1
+                               or coalesce(commits_after_first_review,0) >= 2)
+      then 'merged_after_rework'
+    when state = 'merged' then 'merged_clean'
+    when state = 'closed' and (coalesce(human_review_count,0) >= 1
+                               or coalesce(human_comment_count,0) >= 1)
+      then 'burn'
+    when state = 'closed' then 'abandoned'
+    when opened_at is not null and opened_at < now() - interval '${STALE_DAYS} days'
+      then 'stale'
+    else 'open'
+  end as outcome
+  from flights
+  where human_review_count is not null
+) computed
+where flights.id = computed.id
+  and flights.outcome is distinct from computed.outcome`;
+
+export async function classifyJob(db: Db): Promise<void> {
+  const run = await startRun(db, 'classify');
+  try {
+    const eligible = await db.query<{ n: number }>(
+      'select count(*)::integer as n from flights where human_review_count is not null',
+    );
+    const changed = await db.query(CLASSIFY_SQL + ' returning 1');
+    await finishRun(db, run, { ok: true, rowsIn: Number(eligible[0].n), rowsOut: changed.length });
+  } catch (error) {
+    await finishRun(db, run, { ok: false, errors: 1, errorSample: String(error) });
+    throw error;
+  }
+}
diff --git a/pipeline/src/jobs/debrief.ts b/pipeline/src/jobs/debrief.ts
new file mode 100644
index 0000000..53bc975
--- /dev/null
+++ b/pipeline/src/jobs/debrief.ts
@@ -0,0 +1,165 @@
+// Debriefs for gated flights only (brief, Pipeline step 7): the quality gate
+// minus the debrief condition itself. Cached by (flight, prompt version);
+// a prompt-version bump revalidates stored debriefs and regenerates only the
+// ones that now fail. A validation failure never blocks publish — the flight
+// simply renders without a debrief and stays out of the index.
+
+import Anthropic from '@anthropic-ai/sdk';
+import type { Db } from '../db.ts';
+import { AGENT_LABELS } from '../agents.ts';
+import {
+  DEBRIEF_PROMPT_VERSION,
+  buildDebriefPrompt,
+  generateDebrief,
+  validateDebrief,
+  type DebriefRecord,
+} from '../debrief.ts';
+import { startRun, finishRun } from '../runlog.ts';
+
+// The gate conditions that do not depend on the debrief itself.
+export const GATED_SQL = `
+  select f.id, f.title, f.body_excerpt, f.agent, r.full_name as repo, f.task_type,
+         f.outcome, f.state, f.additions, f.deletions, f.files_changed, f.commits,
+         f.review_count, f.change_requests, f.review_comment_count, f.hours_to_merge,
+         f.reviewer_excerpt, f.debrief, f.debrief_prompt_version
+  from flights f
+  join repos r on r.id = f.repo_id
+  join authors a on a.id = f.author_id
+  left join claims c on c.flight_id = f.id
+  where f.confidence in ('high','medium','dataset')
+    and coalesce(r.stars, 0) >= 100
+    and r.is_fork is not true and r.excluded is not true
+    and a.opted_out is not true
+    and (c.flight_id is null or c.visibility = 'public')
+    and ((coalesce(f.additions,0) + coalesce(f.deletions,0)) >= 20
+           and coalesce(f.files_changed,0) >= 1
+         or coalesce(f.human_review_count,0) >= 1)
+    and f.outcome in ('merged_clean','merged_after_rework','burn')
+    and (f.debrief is null and f.debrief_failed_at is null
+         or f.debrief_prompt_version is distinct from $1)
+  order by f.id
+  limit $2`;
+
+type Row = DebriefRecord & { id: number; agent: string; debrief: string | null; debrief_prompt_version: string | null };
+
+export async function debriefJob(
+  db: Db,
+  opts: { limit?: number; dryRun?: boolean; client?: Anthropic; concurrency?: number } = {},
+): Promise<void> {
+  const run = await startRun(db, 'debrief', { promptVersion: DEBRIEF_PROMPT_VERSION });
+  let written = 0;
+  let failed = 0;
+  let revalidated = 0;
+  let errorSample: string | undefined;
+  try {
+    const rows = await db.query<Row>(GATED_SQL, [DEBRIEF_PROMPT_VERSION, opts.limit ?? 5000]);
+    if (opts.dryRun) {
+      const first = rows[0];
+      if (first) console.log(JSON.stringify(buildDebriefPrompt(toRecord(first)), null, 2));
+      console.log(`${rows.length} flights need a debrief (dry run — nothing written)`);
+      await finishRun(db, run, { ok: true, rowsIn: rows.length, rowsOut: 0 });
+      return;
+    }
+    const client = opts.client ?? new Anthropic();
+
+    // Prompt-version bump: revalidate existing debriefs first; only failures
+    // regenerate (brief: "A prompt change re-runs validation across all
+    // debriefs; failing ones are regenerated").
+    const toGenerate: Row[] = [];
+    for (const row of rows) {
+      if (row.debrief && row.debrief_prompt_version !== DEBRIEF_PROMPT_VERSION) {
+        const verdict = validateDebrief(row.debrief, toRecord(row));
+        if (verdict.ok) {
+          await db.query('update flights set debrief_prompt_version = $2 where id = $1', [
+            row.id,
+            DEBRIEF_PROMPT_VERSION,
+          ]);
+          revalidated++;
+          continue;
+        }
+      }
+      toGenerate.push(row);
+    }
+
+    const concurrency = opts.concurrency ?? 4;
+    let next = 0;
+    const worker = async () => {
+      for (;;) {
+        const index = next++;
+        if (index >= toGenerate.length) return;
+        const row = toGenerate[index];
+        try {
+          const result = await generateDebrief(client, toRecord(row));
+          if (result.ok) {
+            await db.query(
+              `update flights set debrief = $2, debrief_prompt_version = $3,
+                 debrief_failed_at = null where id = $1`,
+              [row.id, result.text, DEBRIEF_PROMPT_VERSION],
+            );
+            written++;
+          } else {
+            await db.query(
+              `update flights set debrief = null, debrief_prompt_version = $2,
+                 debrief_failed_at = now() where id = $1`,
+              [row.id, DEBRIEF_PROMPT_VERSION],
+            );
+            failed++;
+            errorSample ??= result.reasons.join('; ');
+          }
+        } catch (error) {
+          failed++;
+          errorSample ??= String(error);
+        }
+        const done = written + failed;
+        if (done % 100 === 0) console.log(`  debriefs ${done}/${toGenerate.length}`);
+      }
+    };
+    await Promise.all(Array.from({ length: concurrency }, worker));
+
+    const failureRate = written + failed > 0 ? failed / (written + failed) : 0;
+    await finishRun(db, run, {
+      ok: true,
+      rowsIn: rows.length,
+      rowsOut: written,
+      errors: failed,
+      errorSample,
+      meta: { revalidated, failureRate: Math.round(failureRate * 1000) / 1000 },
+    });
+    // Alert hook (brief, Monitoring): debrief failure rate past 5%.
+    if (written + failed >= 20 && failureRate > 0.05) {
+      throw new Error(`debrief failure rate ${(failureRate * 100).toFixed(1)}% exceeds 5%`);
+    }
+  } catch (error) {
+    if (!String(error).includes('failure rate')) {
+      await finishRun(db, run, { ok: false, rowsOut: written, errors: failed + 1, errorSample: String(error) });
+    }
+    throw error;
+  }
+}
+
+function toRecord(row: Row): DebriefRecord {
+  return {
+    title: row.title,
+    body_excerpt: row.body_excerpt,
+    agent_label: AGENT_LABELS[row.agent] ?? row.agent,
+    repo: row.repo,
+    task_type: row.task_type,
+    outcome: row.outcome as string,
+    state: row.state,
+    additions: numOrNull(row.additions),
+    deletions: numOrNull(row.deletions),
+    files_changed: numOrNull(row.files_changed),
+    commits: numOrNull(row.commits),
+    review_count: numOrNull(row.review_count),
+    change_requests: numOrNull(row.change_requests),
+    review_comment_count: numOrNull(row.review_comment_count),
+    hours_to_merge: numOrNull(row.hours_to_merge),
+    reviewer_excerpt: row.reviewer_excerpt,
+  };
+}
+
+function numOrNull(v: unknown): number | null {
+  if (v === null || v === undefined) return null;
+  const n = Number(v);
+  return Number.isFinite(n) ? n : null;
+}
diff --git a/pipeline/src/jobs/discover.ts b/pipeline/src/jobs/discover.ts
new file mode 100644
index 0000000..12bb3d7
--- /dev/null
+++ b/pipeline/src/jobs/discover.ts
@@ -0,0 +1,138 @@
+// Daily GH Archive discovery (06:00 UTC for the previous day). Candidates
+// land as pending_candidates rows on the flight itself: a minimal flight row
+// (confidence from the discovery signal alone) that enrichment then fills.
+// Closed/reopened actions for PRs we already track queue a state refresh by
+// clearing enriched_at.
+
+import type { Db } from '../db.ts';
+import { bigquery, discoverySql } from '../bigquery.ts';
+import { detectSignals } from '../agents.ts';
+import { required } from '../env.ts';
+import { startRun, finishRun } from '../runlog.ts';
+import { pgTextArray } from './load-aidev.ts';
+
+function yesterdayUTC(): string {
+  const d = new Date(Date.now() - 86_400_000);
+  return d.toISOString().slice(0, 10).replace(/-/g, '');
+}
+
+export async function discover(db: Db, opts: { date?: string; dryRun?: boolean }): Promise<void> {
+  const date = (opts.date ?? yesterdayUTC()).replace(/-/g, '');
+  const sql = discoverySql(date);
+  if (opts.dryRun) {
+    console.log(sql);
+    return;
+  }
+  const run = await startRun(db, 'discover', { date });
+  try {
+    const { rows, bytesProcessed } = await bigquery(required('BQ_SERVICE_ACCOUNT_JSON'), sql);
+    let inserted = 0;
+    let stateQueued = 0;
+    let skipped = 0;
+
+    for (const r of rows) {
+      const repoFull = r.repo;
+      const number = Number(r.number);
+      if (!repoFull || !repoFull.includes('/') || !Number.isFinite(number)) {
+        skipped++;
+        continue;
+      }
+      const detection = detectSignals({
+        authorLogin: r.login,
+        headRef: r.head_ref,
+        commitMessages: [],
+        coAuthors: r.coauthor_push === 'true' ? ['agent-coauthor-push'] : [],
+      });
+      // A PR with no signal is not a flight. (A coauthor_push alone names no
+      // agent yet — enrichment reads the commits and decides; store it as a
+      // low-confidence unknown so enrichment picks it up.)
+      const signals = detection?.signals ?? [];
+      if (r.coauthor_push === 'true') signals.push('push:coauthor-trailer');
+      if (signals.length === 0) {
+        skipped++;
+        continue;
+      }
+
+      if (r.action === 'opened') {
+        const authorId = await upsertAuthor(db, r.login, r.user_id);
+        const repoId = await upsertRepo(db, repoFull);
+        if (authorId === null || repoId === null) {
+          skipped++;
+          continue;
+        }
+        const res = await db.query(
+          `insert into flights (github_pr_id, repo_id, author_id, number, agent, signals,
+                                confidence, state, opened_at, source)
+           values ($1, $2, $3, $4, $5, $6::text[], $7, 'open', $8, 'gharchive')
+           on conflict (repo_id, number) do nothing
+           returning 1`,
+          [
+            r.pr_id ? Number(r.pr_id) : null,
+            repoId,
+            authorId,
+            number,
+            detection?.agent ?? 'unknown',
+            pgTextArray(signals),
+            detection?.confidence ?? 'low',
+            r.created_at,
+          ],
+        );
+        inserted += res.length;
+      } else {
+        // closed / reopened for a PR we may track: queue a re-enrichment.
+        const res = await db.query(
+          `update flights f set enriched_at = null
+           from repos r
+           where r.id = f.repo_id and r.full_name_lower = lower($1) and f.number = $2
+           returning 1`,
+          [repoFull, number],
+        );
+        stateQueued += res.length;
+      }
+    }
+
+    await finishRun(db, run, {
+      ok: true,
+      rowsIn: rows.length,
+      rowsOut: inserted,
+      meta: { date, bytesProcessed, stateQueued, skipped },
+    });
+    // The alert hook: a zero-candidate day means the GH Archive table is late
+    // or the query broke (brief, Monitoring) — fail the job so Actions alerts.
+    if (rows.length === 0) {
+      throw new Error(`discovery found zero candidates for ${date} — table late or query broken`);
+    }
+  } catch (error) {
+    if (!String(error).includes('zero candidates')) {
+      await finishRun(db, run, { ok: false, errors: 1, errorSample: String(error) });
+    }
+    throw error;
+  }
+}
+
+async function upsertAuthor(db: Db, login: string | null, userId: string | null): Promise<number | null> {
+  if (!login || !userId || !Number.isFinite(Number(userId))) return null;
+  const rows = await db.query<{ id: number }>(
+    `insert into authors (github_user_id, login, avatar_url, is_bot)
+     values ($1, $2, $3, $4)
+     on conflict (github_user_id) do update set login = excluded.login
+     returning id`,
+    [
+      Number(userId),
+      login,
+      `https://avatars.githubusercontent.com/u/${Number(userId)}?v=4`,
+      login.endsWith('[bot]') || login.toLowerCase() === 'copilot',
+    ],
+  );
+  return rows.length > 0 ? Number(rows[0].id) : null;
+}
+
+async function upsertRepo(db: Db, fullName: string): Promise<number | null> {
+  const rows = await db.query<{ id: number }>(
+    `insert into repos (full_name) values ($1)
+     on conflict (full_name_lower) do update set full_name = excluded.full_name
+     returning id`,
+    [fullName],
+  );
+  return rows.length > 0 ? Number(rows[0].id) : null;
+}
diff --git a/pipeline/src/jobs/enrich.ts b/pipeline/src/jobs/enrich.ts
new file mode 100644
index 0000000..db1ea74
--- /dev/null
+++ b/pipeline/src/jobs/enrich.ts
@@ -0,0 +1,254 @@
+// GraphQL enrichment (brief, Pipeline step 5): every new candidate and every
+// flight whose state changed (discovery cleared enriched_at), plus claimed
+// long-tail flights that have never been enriched. 25 PRs per call via
+// aliases; the exact GraphQL response is kept in flights.raw.
+
+import type { Db } from '../db.ts';
+import { GraphqlClient, buildPrBatchQuery, parsePrNode, type EnrichedPr, type PrRef } from '../github-graphql.ts';
+import { detectSignals } from '../agents.ts';
+import { classifyOutcome, pickReviewerExcerpt, type ExcerptCandidate } from '../classify.ts';
+import { excerpt300, firstWords, hoursBetween } from '../text.ts';
+import { required } from '../env.ts';
+import { startRun, finishRun } from '../runlog.ts';
+import { pgTextArray } from './load-aidev.ts';
+
+const BATCH = 25;
+
+type Pending = { id: number; owner: string; name: string; number: number };
+
+export async function enrich(
+  db: Db,
+  opts: { limit?: number; client?: GraphqlClient; includeOpenOlderThanDays?: number } = {},
+): Promise<void> {
+  const run = await startRun(db, 'enrich');
+  const client = opts.client ?? new GraphqlClient({ token: required('FLIGHTLOG_GITHUB_TOKEN') });
+  let fetched = 0;
+  let updated = 0;
+  let errors = 0;
+  let errorSample: string | undefined;
+  try {
+    const staleOpen = opts.includeOpenOlderThanDays;
+    const pending = await db.query<Pending>(
+      `select f.id, r.owner, r.name, f.number
+       from flights f join repos r on r.id = f.repo_id
+       where (f.enriched_at is null and (f.source = 'gharchive'
+                or exists (select 1 from claims c where c.flight_id = f.id)))
+          ${staleOpen ? `or (f.state = 'open' and f.enriched_at < now() - ($2 || ' days')::interval)` : ''}
+       order by f.id
+       limit $1`,
+      staleOpen ? [opts.limit ?? 2000, String(staleOpen)] : [opts.limit ?? 2000],
+    );
+
+    for (let i = 0; i < pending.length; i += BATCH) {
+      const batch = pending.slice(i, i + BATCH);
+      const refs: PrRef[] = batch.map((p) => ({ owner: p.owner, name: p.name, number: Number(p.number) }));
+      const result = await client.request(buildPrBatchQuery(refs));
+      for (let j = 0; j < batch.length; j++) {
+        const alias = `p${j}`;
+        const node = result.data?.[alias];
+        const pathErrors = (result.errors ?? []).filter((e) => e.path?.[0] === alias);
+        try {
+          const parsed = parsePrNode(node);
+          if (!parsed) {
+            // Deleted, private, or renamed away: stamp enriched_at so the row
+            // stops queueing, and record why in signals.
+            await db.query(
+              `update flights set enriched_at = now(),
+                 signals = (select array(select distinct unnest(signals || $2::text[])))
+               where id = $1`,
+              [batch[j].id, pgTextArray([`enrich:${pathErrors[0]?.type?.toLowerCase() ?? 'not_found'}`])],
+            );
+            errors++;
+            errorSample ??= pathErrors[0]?.message;
+            continue;
+          }
+          await applyEnrichment(db, batch[j].id, parsed);
+          updated++;
+        } catch (error) {
+          errors++;
+          errorSample ??= String(error);
+        }
+      }
+      fetched += batch.length;
+      console.log(`  enriched ${Math.min(i + BATCH, pending.length)}/${pending.length}`);
+    }
+    await finishRun(db, run, {
+      ok: true,
+      rowsIn: pending.length,
+      rowsOut: updated,
+      errors,
+      errorSample,
+      meta: { graphqlRemaining: client.lastRemaining },
+    });
+  } catch (error) {
+    await finishRun(db, run, {
+      ok: false,
+      rowsIn: fetched,
+      rowsOut: updated,
+      errors: errors + 1,
+      errorSample: String(error),
+      meta: { graphqlRemaining: client.lastRemaining },
+    });
+    throw error;
+  }
+}
+
+async function applyEnrichment(db: Db, flightId: number, pr: EnrichedPr): Promise<void> {
+  // Repo metadata rides along in the same response.
+  if (pr.repo.nameWithOwner) {
+    await db.query(
+      `update repos set github_repo_id = coalesce($2, github_repo_id), stars = $3,
+         primary_language = $4, license = $5, is_fork = $6, fetched_at = now()
+       where id = (select repo_id from flights where id = $1)`,
+      [
+        flightId,
+        pr.repo.databaseId,
+        pr.repo.stargazerCount,
+        pr.repo.primaryLanguage,
+        pr.repo.license,
+        pr.repo.isFork,
+      ],
+    );
+  }
+  if (pr.authorDatabaseId !== null && pr.authorLogin) {
+    await db.query(
+      `update authors set login = $2, is_bot = $3, fetched_at = now()
+       where github_user_id = $1`,
+      [pr.authorDatabaseId, pr.authorLogin, pr.authorIsBot],
+    );
+  }
+
+  // Confirm signals from the live PR (brief: set confidence high with 2+
+  // signals, medium with one bot/trailer signal, low with a branch prefix).
+  const detection = detectSignals({
+    authorLogin: pr.authorLogin,
+    headRef: pr.headRefName,
+    commitMessages: pr.commitMessages,
+  });
+
+  const prAuthor = (pr.authorLogin ?? '').toLowerCase();
+  const humanReviews = pr.reviews.filter(
+    (r) => !r.authorIsBot && (r.authorLogin ?? '').toLowerCase() !== prAuthor,
+  );
+  const humanComments = pr.comments.filter(
+    (c) => !c.authorIsBot && (c.authorLogin ?? '').toLowerCase() !== prAuthor,
+  );
+  const changeRequests = pr.reviews.filter((r) => r.state === 'CHANGES_REQUESTED').length;
+  const firstReviewAt =
+    pr.reviews.map((r) => r.submittedAt).filter((d): d is string => !!d).sort()[0] ?? null;
+  const commitsAfterFirstReview = firstReviewAt
+    ? pr.timeline.filter((t) => t.kind === 'committed' && t.at && t.at > firstReviewAt).length
+    : 0;
+
+  const candidates: ExcerptCandidate[] = [
+    ...pr.reviews.map((r) => ({
+      kind: 'review' as const,
+      state: r.state,
+      authorLogin: r.authorLogin,
+      authorIsBot: r.authorIsBot,
+      body: r.body,
+      createdAt: r.submittedAt,
+      url: r.url,
+    })),
+    ...pr.comments.map((c) => ({
+      kind: 'comment' as const,
+      authorLogin: c.authorLogin,
+      authorIsBot: c.authorIsBot,
+      body: c.body,
+      createdAt: c.createdAt,
+      url: c.url,
+    })),
+  ];
+  const excerptPick = pickReviewerExcerpt(candidates, pr.authorLogin, firstWords);
+
+  const outcome = classifyOutcome({
+    state: pr.state,
+    openedAt: pr.createdAt,
+    changeRequests,
+    humanReviewCount: humanReviews.length,
+    humanCommentCount: humanComments.length,
+    commitsAfterFirstReview,
+  });
+
+  const { excerpt, chars } = excerpt300(pr.bodyText);
+  await db.query(
+    `update flights set
+       github_pr_id = coalesce($2, github_pr_id),
+       title = $3, body_excerpt = $4, body_chars = $5,
+       state = $6, opened_at = $7, merged_at = $8, closed_at = $9,
+       additions = $10, deletions = $11, files_changed = $12, commits = $13,
+       metrics_source = 'github_api',
+       review_count = $14, change_requests = $15, review_comment_count = $16,
+       human_review_count = $17, human_comment_count = $18,
+       first_review_at = $19, commits_after_first_review = $20,
+       hours_to_merge = $21,
+       outcome = $22, classified_at = now(),
+       reviewer_excerpt = $23, reviewer_excerpt_url = $24,
+       agent = case when $25 <> 'unknown' then $25 else agent end,
+       signals = (select array(select distinct unnest(signals || $26::text[]))),
+       confidence = coalesce($27, confidence),
+       raw = $28::jsonb,
+       enriched_at = now()
+     where id = $1`,
+    [
+      flightId,
+      pr.ghPrId,
+      pr.title,
+      excerpt,
+      chars,
+      pr.state,
+      pr.createdAt,
+      pr.mergedAt,
+      pr.closedAt,
+      pr.additions,
+      pr.deletions,
+      pr.changedFiles,
+      pr.commitsTotal,
+      pr.reviews.length,
+      changeRequests,
+      pr.reviewCommentCount,
+      humanReviews.length,
+      humanComments.length,
+      firstReviewAt,
+      commitsAfterFirstReview,
+      hoursBetween(pr.createdAt, pr.mergedAt),
+      outcome,
+      excerptPick?.excerpt ?? null,
+      excerptPick?.url ?? null,
+      detection?.agent ?? 'unknown',
+      pgTextArray(detection?.signals ?? []),
+      detection?.confidence ?? null,
+      JSON.stringify(pr.raw),
+    ],
+  );
+
+  // Events: reviews (+changes_requested) from the reviews list, the rest from
+  // the timeline; replaced wholesale.
+  await db.query('delete from flight_events where flight_id = $1', [flightId]);
+  const events = [
+    ...pr.timeline,
+    ...pr.reviews.flatMap((r) => {
+      const base = { at: r.submittedAt, actor: r.authorLogin, url: r.url };
+      return r.state === 'CHANGES_REQUESTED'
+        ? [{ kind: 'changes_requested', ...base }]
+        : [{ kind: 'reviewed', ...base }];
+    }),
+  ]
+    .sort((a, b) => (a.at ?? '').localeCompare(b.at ?? ''))
+    .slice(0, 200);
+  if (events.length > 0) {
+    const params: unknown[] = [];
+    const tuples = events
+      .map((e, seq) => {
+        params.push(flightId, seq, e.kind, e.actor, e.at, e.url);
+        const base = params.length - 6;
+        return `($${base + 1},$${base + 2},$${base + 3},$${base + 4},$${base + 5},$${base + 6})`;
+      })
+      .join(',');
+    await db.query(
+      `insert into flight_events (flight_id, seq, kind, actor_login, at, url)
+       values ${tuples} on conflict (flight_id, seq) do nothing`,
+      params,
+    );
+  }
+}
diff --git a/pipeline/src/jobs/load-aidev.ts b/pipeline/src/jobs/load-aidev.ts
new file mode 100644
index 0000000..7a1fa8f
--- /dev/null
+++ b/pipeline/src/jobs/load-aidev.ts
@@ -0,0 +1,598 @@
+// Backfill from AIDev (pinned revision, default v3 — the brief's cut:
+// 932,791 PRs; AIDev-pop 33,596 across 2,807 repos >100 stars).
+//
+// Order (brief, "Backfill run order"): core first (no API), then the pop
+// detail tables and computed metrics (no API). Idempotent: repos/authors/
+// flights upsert; detail metrics overwrite only fields the detail tables own,
+// and never touch a flight that GraphQL has since enriched.
+//
+// Data minimisation at load time: logins and numeric ids only. Commit
+// messages are scanned for agent trailers and then dropped — author strings
+// and any emails inside trailers are never stored.
+
+import type { Db } from '../db.ts';
+import { insertBatch } from '../db.ts';
+import { aidevAgentToSlug, avatarUrl, isBotLogin, signalsFromCommitMessage } from '../agents.ts';
+import { excerpt300, firstWords, hoursBetween } from '../text.ts';
+import { pickReviewerExcerpt, type ExcerptCandidate } from '../classify.ts';
+import { iso, num, readColumns, str } from '../parquet.ts';
+import { startRun, finishRun } from '../runlog.ts';
+import { join } from 'node:path';
+
+/** PG text[] literal from JS strings (works on postgres.js and PGlite). */
+export function pgTextArray(items: string[]): string {
+  const quoted = items.map((s) => `"${s.replace(/\\/g, '\\\\').replace(/"/g, '\\"')}"`);
+  return `{${quoted.join(',')}}`;
+}
+
+/** "https://api.github.com/repos/o/r" | "https://github.com/o/r" → "o/r". */
+export function fullNameFromRepoUrl(url: string | null): string | null {
+  if (!url) return null;
+  const m = url.match(/github\.com\/(?:repos\/)?([^/]+\/[^/\s]+)/);
+  return m ? m[1].replace(/\.git$/, '') : null;
+}
+
+type Opts = {
+  dir: string;
+  /** Load only the first N core rows (smoke tests). */
+  sample?: number;
+  skipCore?: boolean;
+  skipPop?: boolean;
+};
+
+export async function loadAidev(db: Db, opts: Opts): Promise<void> {
+  const run = await startRun(db, 'load-aidev', { dir: opts.dir, sample: opts.sample ?? null });
+  let rowsIn = 0;
+  let rowsOut = 0;
+  try {
+    const seeded = await seedReposAndAuthors(db, opts.dir);
+    rowsOut += seeded;
+    if (!opts.skipCore) {
+      const core = await loadCore(db, opts.dir, opts.sample);
+      rowsIn += core.read;
+      rowsOut += core.written;
+    }
+    if (!opts.skipPop) {
+      const pop = await loadPopDetail(db, opts.dir, opts.sample);
+      rowsIn += pop.read;
+      rowsOut += pop.written;
+    }
+    await finishRun(db, run, { ok: true, rowsIn, rowsOut });
+  } catch (error) {
+    await finishRun(db, run, {
+      ok: false,
+      rowsIn,
+      rowsOut,
+      errors: 1,
+      errorSample: String(error),
+    });
+    throw error;
+  }
+}
+
+// --- repos + authors -------------------------------------------------------
+
+async function seedReposAndAuthors(db: Db, dir: string): Promise<number> {
+  let written = 0;
+  for (const file of ['all_repository.parquet', 'repository.parquet']) {
+    const rows = await readColumns(join(dir, file), ['id', 'full_name', 'language', 'stars', 'license']);
+    const values = rows
+      .filter((r) => str(r.full_name)?.includes('/'))
+      .map((r) => [num(r.id), str(r.full_name), num(r.stars), str(r.language), str(r.license)]);
+    written += await insertBatch(
+      db,
+      'repos',
+      ['github_repo_id', 'full_name', 'stars', 'primary_language', 'license'],
+      values,
+      `on conflict (github_repo_id) do update set
+         stars = coalesce(excluded.stars, repos.stars),
+         primary_language = coalesce(excluded.primary_language, repos.primary_language),
+         license = coalesce(excluded.license, repos.license)`,
+    );
+    console.log(`  ${file}: ${rows.length} rows`);
+  }
+  for (const file of ['all_user.parquet', 'user.parquet']) {
+    const rows = await readColumns(join(dir, file), ['id', 'login']);
+    const values: unknown[][] = [];
+    const seen = new Set<number>();
+    for (const r of rows) {
+      const id = num(r.id);
+      const login = str(r.login);
+      if (id === null || !login || seen.has(id)) continue;
+      seen.add(id);
+      values.push([id, login, avatarUrl(id), isBotLogin(login)]);
+    }
+    written += await insertBatch(
+      db,
+      'authors',
+      ['github_user_id', 'login', 'avatar_url', 'is_bot'],
+      values,
+      'on conflict (github_user_id) do update set login = excluded.login, avatar_url = excluded.avatar_url, is_bot = excluded.is_bot',
+    );
+    console.log(`  ${file}: ${rows.length} rows`);
+  }
+  return written;
+}
+
+async function repoIdMap(db: Db): Promise<Map<number, number>> {
+  const rows = await db.query<{ id: number; github_repo_id: number }>(
+    'select id, github_repo_id from repos where github_repo_id is not null',
+  );
+  return new Map(rows.map((r) => [Number(r.github_repo_id), Number(r.id)]));
+}
+
+async function repoNameMap(db: Db): Promise<Map<string, number>> {
+  const rows = await db.query<{ id: number; full_name_lower: string }>(
+    'select id, full_name_lower from repos',
+  );
+  return new Map(rows.map((r) => [r.full_name_lower, Number(r.id)]));
+}
+
+async function authorIdMap(db: Db): Promise<Map<number, number>> {
+  const rows = await db.query<{ id: number; github_user_id: number }>(
+    'select id, github_user_id from authors',
+  );
+  return new Map(rows.map((r) => [Number(r.github_user_id), Number(r.id)]));
+}
+
+// --- flight upserts (shared by the core and pop loads) ----------------------
+
+type CoreRow = {
+  id: unknown;
+  number: unknown;
+  title: unknown;
+  body?: unknown;
+  user: unknown;
+  user_id: unknown;
+  state: unknown;
+  created_at: unknown;
+  closed_at: unknown;
+  merged_at: unknown;
+  repo_url: unknown;
+  repo_id: unknown;
+  agent: unknown;
+};
+
+const FLIGHT_COLUMNS = [
+  'github_pr_id', 'repo_id', 'author_id', 'number', 'title', 'body_excerpt', 'body_chars',
+  'agent', 'signals', 'confidence', 'state', 'opened_at', 'merged_at', 'closed_at',
+  'hours_to_merge', 'source',
+];
+
+// Core fields come from the dataset; a flight GraphQL has already enriched is
+// never overwritten by a backfill re-run.
+const FLIGHT_CONFLICT = `on conflict (repo_id, number) do update set
+   github_pr_id = coalesce(flights.github_pr_id, excluded.github_pr_id),
+   title = excluded.title,
+   body_excerpt = excluded.body_excerpt,
+   body_chars = excluded.body_chars,
+   state = excluded.state,
+   opened_at = excluded.opened_at,
+   merged_at = excluded.merged_at,
+   closed_at = excluded.closed_at,
+   hours_to_merge = excluded.hours_to_merge
+ where flights.enriched_at is null`;
+
+/**
+ * Upsert flights from AIDev PR rows (core or pop — same columns), creating
+ * stub repos/authors for rows the dataset's dimension tables miss.
+ */
+async function upsertFlightRows(
+  db: Db,
+  rows: CoreRow[],
+  bodyOf: (i: number) => string | null,
+): Promise<number> {
+  const repoByGhId = await repoIdMap(db);
+  const repoByName = await repoNameMap(db);
+  const authorByGhId = await authorIdMap(db);
+
+  const missingRepos = new Map<string, [number | null, string]>();
+  const missingAuthors = new Map<number, string>();
+  for (const r of rows) {
+    const ghRepo = num(r.repo_id);
+    const name = fullNameFromRepoUrl(str(r.repo_url));
+    if ((ghRepo === null || !repoByGhId.has(ghRepo)) && name && !repoByName.has(name.toLowerCase())) {
+      missingRepos.set(name.toLowerCase(), [ghRepo, name]);
+    }
+    const ghUser = num(r.user_id);
+    const login = str(r.user);
+    if (ghUser !== null && login && !authorByGhId.has(ghUser)) missingAuthors.set(ghUser, login);
+  }
+  if (missingRepos.size > 0) {
+    await insertBatch(
+      db,
+      'repos',
+      ['github_repo_id', 'full_name'],
+      [...missingRepos.values()],
+      'on conflict (full_name_lower) do nothing',
+    );
+    for (const [k, v] of await repoNameMap(db)) repoByName.set(k, v);
+    for (const [k, v] of await repoIdMap(db)) repoByGhId.set(k, v);
+  }
+  if (missingAuthors.size > 0) {
+    await insertBatch(
+      db,
+      'authors',
+      ['github_user_id', 'login', 'avatar_url', 'is_bot'],
+      [...missingAuthors.entries()].map(([id, login]) => [id, login, avatarUrl(id), isBotLogin(login)]),
+      'on conflict (github_user_id) do nothing',
+    );
+    for (const [k, v] of await authorIdMap(db)) authorByGhId.set(k, v);
+  }
+
+  let written = 0;
+  let skipped = 0;
+  let values: unknown[][] = [];
+  for (let i = 0; i < rows.length; i++) {
+    const r = rows[i];
+    const ghRepo = num(r.repo_id);
+    const name = fullNameFromRepoUrl(str(r.repo_url))?.toLowerCase();
+    const repoId =
+      (ghRepo !== null ? repoByGhId.get(ghRepo) : undefined) ??
+      (name ? repoByName.get(name) : undefined);
+    const ghUser = num(r.user_id);
+    const authorId = ghUser !== null ? authorByGhId.get(ghUser) : undefined;
+    const number = num(r.number);
+    if (repoId === undefined || authorId === undefined || number === null) {
+      skipped++;
+      continue;
+    }
+    const mergedAt = iso(r.merged_at);
+    const state = mergedAt ? 'merged' : str(r.state) === 'open' ? 'open' : 'closed';
+    const { excerpt, chars } = excerpt300(bodyOf(i));
+    values.push([
+      num(r.id),
+      repoId,
+      authorId,
+      number,
+      str(r.title) ?? '',
+      excerpt,
+      chars,
+      aidevAgentToSlug(str(r.agent) ?? ''),
+      pgTextArray([`aidev:${str(r.agent) ?? 'unknown'}`]),
+      'dataset',
+      state,
+      iso(r.created_at),
+      mergedAt,
+      iso(r.closed_at),
+      hoursBetween(iso(r.created_at), mergedAt),
+      'aidev',
+    ]);
+    if (values.length >= 20_000) {
+      written += await insertBatch(db, 'flights', FLIGHT_COLUMNS, values, FLIGHT_CONFLICT);
+      values = [];
+    }
+  }
+  if (values.length > 0) {
+    written += await insertBatch(db, 'flights', FLIGHT_COLUMNS, values, FLIGHT_CONFLICT);
+  }
+  if (skipped > 0) console.log(`  skipped ${skipped} rows with no resolvable repo/author`);
+  return written;
+}
+
+// --- core (all 933k PRs, metadata only) -------------------------------------
+
+async function loadCore(
+  db: Db,
+  dir: string,
+  sample?: number,
+): Promise<{ read: number; written: number }> {
+  const path = join(dir, 'all_pull_request.parquet');
+  const range = sample ? { rowStart: 0, rowEnd: sample } : undefined;
+  console.log('  reading core columns…');
+  const meta = (await readColumns(
+    path,
+    ['id', 'number', 'title', 'user', 'user_id', 'state', 'created_at', 'closed_at', 'merged_at', 'repo_url', 'repo_id', 'agent'],
+    range,
+  )) as CoreRow[];
+  console.log(`  core rows: ${meta.length}; reading bodies…`);
+  const bodies = (await readColumns(path, ['body'], range)) as { body: unknown }[];
+  const written = await upsertFlightRows(db, meta, (i) => str(bodies[i]?.body));
+  console.log(`  core upserted: ${written}`);
+  return { read: meta.length, written };
+}
+
+// --- AIDev-pop detail tables → metrics, excerpts, events --------------------
+
+type PopPr = {
+  ghPrId: number;
+  flightId?: number;
+  htmlUrl: string | null;
+  authorLogin: string | null;
+  additions?: number;
+  deletions?: number;
+  files?: Set<string>;
+  commits?: number;
+  commitSignals?: Set<string>;
+  reviewCount?: number;
+  changeRequests?: number;
+  humanReviewCount?: number;
+  firstReviewAt?: string | null;
+  reviewCommentCount?: number;
+  humanCommentCount?: number;
+  taskType?: string | null;
+  candidates: ExcerptCandidate[];
+  events: { kind: string; at: string | null; actor: string | null; url: string | null }[];
+  commitsAfterFirstReview?: number;
+};
+
+async function loadPopDetail(
+  db: Db,
+  dir: string,
+  sample?: number,
+): Promise<{ read: number; written: number }> {
+  let read = 0;
+  const popRows = await readColumns(join(dir, 'pull_request.parquet'), [
+    'id', 'number', 'title', 'body', 'agent', 'user_id', 'user', 'state', 'created_at', 'closed_at', 'merged_at', 'repo_id', 'repo_url', 'html_url',
+  ]);
+  read += popRows.length;
+
+  // Pop rows are a subset of core, but upserting them here keeps this step
+  // self-sufficient (core-skipping runs, smoke tests) and is a no-op after a
+  // core load. In sample mode only the first N pop PRs are processed.
+  const popSlice = (sample ? popRows.slice(0, sample) : popRows) as CoreRow[];
+  await upsertFlightRows(db, popSlice, (i) => str((popSlice[i] as { body?: unknown }).body));
+
+  const prs = new Map<number, PopPr>();
+  for (const r of popSlice as { id: unknown; html_url: unknown; user: unknown }[]) {
+    const id = num(r.id);
+    if (id === null) continue;
+    prs.set(id, {
+      ghPrId: id,
+      htmlUrl: str(r.html_url),
+      authorLogin: str(r.user),
+      candidates: [],
+      events: [],
+    });
+  }
+
+  // pr_commit_details: per-commit per-file additions/deletions. Summed across
+  // commits (an approximation GraphQL later replaces); patches are not read.
+  {
+    const rows = await readColumns(join(dir, 'pr_commit_details.parquet'), ['pr_id', 'filename', 'additions', 'deletions', 'sha']);
+    read += rows.length;
+    const shas = new Map<number, Set<string>>();
+    for (const r of rows) {
+      const pr = prs.get(num(r.pr_id) ?? -1);
+      if (!pr) continue;
+      pr.additions = (pr.additions ?? 0) + (num(r.additions) ?? 0);
+      pr.deletions = (pr.deletions ?? 0) + (num(r.deletions) ?? 0);
+      (pr.files ??= new Set()).add(str(r.filename) ?? '');
+      const sha = str(r.sha);
+      if (sha) {
+        let set = shas.get(pr.ghPrId);
+        if (!set) shas.set(pr.ghPrId, (set = new Set()));
+        set.add(sha);
+      }
+    }
+    for (const [id, set] of shas) {
+      const pr = prs.get(id);
+      if (pr) pr.commits = set.size;
+    }
+    console.log(`  pr_commit_details: ${rows.length} rows`);
+  }
+
+  // pr_commits: commit count (covers PRs missing from commit_details) and
+  // agent trailers in messages. Messages are scanned and dropped.
+  {
+    const rows = await readColumns(join(dir, 'pr_commits.parquet'), ['pr_id', 'sha', 'message']);
+    read += rows.length;
+    const counts = new Map<number, number>();
+    for (const r of rows) {
+      const id = num(r.pr_id) ?? -1;
+      const pr = prs.get(id);
+      if (!pr) continue;
+      counts.set(id, (counts.get(id) ?? 0) + 1);
+      const message = str(r.message) ?? '';
+      for (const signal of signalsFromCommitMessage(message)) (pr.commitSignals ??= new Set()).add(signal);
+    }
+    for (const [id, n] of counts) {
+      const pr = prs.get(id)!;
+      pr.commits = Math.max(pr.commits ?? 0, n);
+    }
+    console.log(`  pr_commits: ${rows.length} rows`);
+  }
+
+  // pr_reviews: counts, first review time, excerpt candidates, review events.
+  const reviewPr = new Map<number, number>(); // review id → pr id
+  {
+    const rows = await readColumns(join(dir, 'pr_reviews.parquet'), ['id', 'pr_id', 'user', 'user_type', 'state', 'submitted_at', 'body']);
+    read += rows.length;
+    for (const r of rows) {
+      const prId = num(r.pr_id) ?? -1;
+      const pr = prs.get(prId);
+      if (!pr) continue;
+      const reviewId = num(r.id);
+      if (reviewId !== null) reviewPr.set(reviewId, prId);
+      const state = (str(r.state) ?? '').toUpperCase();
+      const login = str(r.user);
+      const isBot = (str(r.user_type) ?? '') === 'Bot' || isBotLogin(login ?? '');
+      const at = iso(r.submitted_at);
+      const url = pr.htmlUrl && reviewId !== null ? `${pr.htmlUrl}#pullrequestreview-${reviewId}` : null;
+      pr.reviewCount = (pr.reviewCount ?? 0) + 1;
+      if (state === 'CHANGES_REQUESTED') {
+        pr.changeRequests = (pr.changeRequests ?? 0) + 1;
+        pr.events.push({ kind: 'changes_requested', at, actor: login, url });
+      }
+      if (!isBot && login && login.toLowerCase() !== (pr.authorLogin ?? '').toLowerCase()) {
+        pr.humanReviewCount = (pr.humanReviewCount ?? 0) + 1;
+      }
+      if (at && (!pr.firstReviewAt || at < pr.firstReviewAt)) pr.firstReviewAt = at;
+      pr.candidates.push({ kind: 'review', state, authorLogin: login, authorIsBot: isBot, body: str(r.body), createdAt: at, url });
+    }
+    console.log(`  pr_reviews: ${rows.length} rows`);
+  }
+
+  // pr_review_comments: inline comment counts via their parent review.
+  {
+    const rows = await readColumns(join(dir, 'pr_review_comments.parquet'), ['pull_request_review_id']);
+    read += rows.length;
+    for (const r of rows) {
+      const prId = reviewPr.get(num(r.pull_request_review_id) ?? -1);
+      const pr = prId === undefined ? undefined : prs.get(prId);
+      if (pr) pr.reviewCommentCount = (pr.reviewCommentCount ?? 0) + 1;
+    }
+    console.log(`  pr_review_comments: ${rows.length} rows`);
+  }
+
+  // pr_comments: discussion comments (human engagement + excerpt candidates).
+  {
+    const rows = await readColumns(join(dir, 'pr_comments.parquet'), ['id', 'pr_id', 'user', 'user_type', 'created_at', 'body']);
+    read += rows.length;
+    for (const r of rows) {
+      const pr = prs.get(num(r.pr_id) ?? -1);
+      if (!pr) continue;
+      const login = str(r.user);
+      const isBot = (str(r.user_type) ?? '') === 'Bot' || isBotLogin(login ?? '');
+      const commentId = num(r.id);
+      if (!isBot && login && login.toLowerCase() !== (pr.authorLogin ?? '').toLowerCase()) {
+        pr.humanCommentCount = (pr.humanCommentCount ?? 0) + 1;
+        pr.candidates.push({
+          kind: 'comment',
+          authorLogin: login,
+          authorIsBot: isBot,
+          body: str(r.body),
+          createdAt: iso(r.created_at),
+          url: pr.htmlUrl && commentId !== null ? `${pr.htmlUrl}#issuecomment-${commentId}` : null,
+        });
+      }
+    }
+    console.log(`  pr_comments: ${rows.length} rows`);
+  }
+
+  // pr_timeline → events + commits-after-first-review.
+  {
+    const KINDS = new Set(['committed', 'reviewed', 'labeled', 'closed', 'merged']);
+    const rows = await readColumns(join(dir, 'pr_timeline.parquet'), ['pr_id', 'event', 'created_at', 'actor']);
+    read += rows.length;
+    for (const r of rows) {
+      const pr = prs.get(num(r.pr_id) ?? -1);
+      const event = str(r.event) ?? '';
+      if (!pr || !KINDS.has(event)) continue;
+      const at = iso(r.created_at);
+      pr.events.push({ kind: event, at, actor: str(r.actor), url: null });
+      if (event === 'committed' && at && pr.firstReviewAt && at > pr.firstReviewAt) {
+        pr.commitsAfterFirstReview = (pr.commitsAfterFirstReview ?? 0) + 1;
+      }
+    }
+    console.log(`  pr_timeline: ${rows.length} rows`);
+  }
+
+  // pr_task_type: GPT-assigned Conventional Commits category (pop only).
+  {
+    const rows = await readColumns(join(dir, 'pr_task_type.parquet'), ['id', 'type']);
+    read += rows.length;
+    for (const r of rows) {
+      const pr = prs.get(num(r.id) ?? -1);
+      if (pr) pr.taskType = str(r.type);
+    }
+  }
+
+  // Resolve flight ids, then write metrics + events in batches.
+  const ids = [...prs.keys()];
+  const flightRows: { id: number; github_pr_id: number }[] = [];
+  for (let i = 0; i < ids.length; i += 10_000) {
+    const chunk = ids.slice(i, i + 10_000);
+    flightRows.push(
+      ...(await db.query<{ id: number; github_pr_id: number }>(
+        `select id, github_pr_id from flights where github_pr_id = any($1::bigint[])`,
+        [`{${chunk.join(',')}}`],
+      )),
+    );
+  }
+  for (const row of flightRows) {
+    const pr = prs.get(Number(row.github_pr_id));
+    if (pr) pr.flightId = Number(row.id);
+  }
+
+  let written = 0;
+  const found = [...prs.values()].filter((p) => p.flightId !== undefined);
+  console.log(`  pop flights found in db: ${found.length} / ${prs.size}`);
+  for (let i = 0; i < found.length; i += 500) {
+    const batch = found.slice(i, i + 500);
+    const params: unknown[] = [];
+    const tuples = batch
+      .map((pr) => {
+        const excerptPick = pickReviewerExcerpt(pr.candidates, pr.authorLogin, firstWords);
+        const extraSignals = [...(pr.commitSignals ?? [])];
+        const row = [
+          pr.flightId,
+          pr.additions ?? null,
+          pr.deletions ?? null,
+          pr.files ? pr.files.size : null,
+          pr.commits ?? null,
+          pr.additions !== undefined ? 'aidev_commit_sum' : null,
+          pr.reviewCount ?? 0,
+          pr.changeRequests ?? 0,
+          pr.reviewCommentCount ?? 0,
+          pr.humanReviewCount ?? 0,
+          pr.humanCommentCount ?? 0,
+          pr.firstReviewAt ?? null,
+          pr.commitsAfterFirstReview ?? 0,
+          pr.taskType ?? null,
+          excerptPick?.excerpt ?? null,
+          excerptPick?.url ?? null,
+          extraSignals.length > 0 ? pgTextArray(extraSignals) : null,
+        ];
+        const placeholders = row.map((v) => {
+          params.push(v);
+          return `$${params.length}`;
+        });
+        return `(${placeholders.join(',')})`;
+      })
+      .join(',');
+    const updated = await db.query(
+      `update flights f set
+         additions = v.additions::integer, deletions = v.deletions::integer,
+         files_changed = v.files_changed::integer, commits = v.commits::integer,
+         metrics_source = coalesce(v.metrics_source, f.metrics_source),
+         review_count = v.review_count::integer, change_requests = v.change_requests::integer,
+         review_comment_count = v.review_comment_count::integer,
+         human_review_count = v.human_review_count::integer,
+         human_comment_count = v.human_comment_count::integer,
+         first_review_at = v.first_review_at::timestamptz,
+         commits_after_first_review = v.commits_after_first_review::integer,
+         task_type = v.task_type,
+         reviewer_excerpt = v.reviewer_excerpt, reviewer_excerpt_url = v.reviewer_excerpt_url,
+         signals = case when v.extra_signals is null then f.signals
+                        else (select array(select distinct unnest(f.signals || v.extra_signals::text[]))) end
+       from (values ${tuples}) as v
+         (flight_id, additions, deletions, files_changed, commits, metrics_source,
+          review_count, change_requests, review_comment_count, human_review_count,
+          human_comment_count, first_review_at, commits_after_first_review, task_type,
+          reviewer_excerpt, reviewer_excerpt_url, extra_signals)
+       where f.id = v.flight_id::bigint and f.enriched_at is null
+       returning 1`,
+      params,
+    );
+    written += updated.length;
+  }
+
+  // flight_events: replace wholesale for these flights (idempotent re-run).
+  const withEvents = found.filter((p) => p.events.length > 0);
+  for (let i = 0; i < withEvents.length; i += 200) {
+    const batch = withEvents.slice(i, i + 200);
+    await db.query(`delete from flight_events where flight_id = any($1::bigint[])`, [
+      `{${batch.map((p) => p.flightId).join(',')}}`,
+    ]);
+    const values: unknown[][] = [];
+    for (const pr of batch) {
+      const events = pr.events
+        .slice()
+        .sort((a, b) => (a.at ?? '').localeCompare(b.at ?? ''))
+        .slice(0, 200);
+      events.forEach((e, seq) => {
+        values.push([pr.flightId, seq, e.kind, e.actor, e.at, e.url]);
+      });
+    }
+    written += await insertBatch(
+      db,
+      'flight_events',
+      ['flight_id', 'seq', 'kind', 'actor_login', 'at', 'url'],
+      values,
+      'on conflict (flight_id, seq) do nothing',
+    );
+  }
+
+  return { read, written };
+}
diff --git a/pipeline/src/jobs/publish.ts b/pipeline/src/jobs/publish.ts
new file mode 100644
index 0000000..5535da5
--- /dev/null
+++ b/pipeline/src/jobs/publish.ts
@@ -0,0 +1,168 @@
+// Publish (brief, Pipeline step 8): recompute index_ok in SQL, spot-check a
+// random sample of would-be-indexed flights, refresh the aggregate views the
+// repo/agent pages read, and render OG cards for newly indexed flights.
+//
+// Spot check: 30 random indexed flights re-validated against the stored
+// record — the debrief must still pass the validator, the reviewer excerpt
+// must be ≤25 words with a github.com URL, and the numbers must be sane.
+// A failure drops those flights back out of the index (debrief cleared, gate
+// recomputed) and fails the job so the owner is paged; the rest of the index
+// stays live. The printed URLs are the by-hand sample (open 30, confirm
+// against GitHub) the brief requires before trusting a publish.
+
+import type { Db } from '../db.ts';
+import { AGENT_LABELS } from '../agents.ts';
+import { validateDebrief, type DebriefRecord } from '../debrief.ts';
+import { flightCard } from '../og.ts';
+import { ensureBucket, uploadPng } from '../storage.ts';
+import { startRun, finishRun } from '../runlog.ts';
+
+export async function publish(db: Db, opts: { skipOg?: boolean; ogLimit?: number } = {}): Promise<void> {
+  const run = await startRun(db, 'publish');
+  try {
+    const changed = await db.query<{ recompute_index_ok: number }>('select recompute_index_ok()');
+    const indexed = await db.query<{ n: number }>(
+      'select count(*)::integer as n from flights where index_ok',
+    );
+
+    const failures = await spotCheck(db);
+    if (failures.length > 0) {
+      for (const id of failures) {
+        await db.query(
+          'update flights set debrief = null, debrief_failed_at = now() where id = $1',
+          [id],
+        );
+      }
+      await db.query('select recompute_index_ok()');
+    }
+
+    await db.query('select refresh_corpus_views()');
+
+    let ogRendered = 0;
+    if (!opts.skipOg) ogRendered = await renderOgCards(db, opts.ogLimit ?? 2000);
+
+    await finishRun(db, run, {
+      ok: failures.length === 0,
+      rowsIn: Number(indexed[0].n),
+      rowsOut: Number(changed[0].recompute_index_ok),
+      errors: failures.length,
+      errorSample: failures.length > 0 ? `spot check failed for flights ${failures.join(', ')}` : undefined,
+      meta: { indexed: Number(indexed[0].n), ogRendered },
+    });
+    if (failures.length > 0) {
+      throw new Error(`spot check failed for ${failures.length} flight(s) — publish blocked for them`);
+    }
+  } catch (error) {
+    if (!String(error).includes('spot check failed')) {
+      await finishRun(db, run, { ok: false, errors: 1, errorSample: String(error) });
+    }
+    throw error;
+  }
+}
+
+type CheckRow = DebriefRecord & {
+  id: number;
+  agent: string;
+  number: number;
+  owner: string;
+  name: string;
+  debrief: string;
+  reviewer_excerpt_url: string | null;
+};
+
+async function spotCheck(db: Db, sample = 30): Promise<number[]> {
+  const rows = await db.query<CheckRow>(
+    `select f.id, f.title, f.body_excerpt, f.agent, r.full_name as repo, r.owner, r.name,
+            f.number, f.task_type, f.outcome, f.state, f.additions, f.deletions,
+            f.files_changed, f.commits, f.review_count, f.change_requests,
+            f.review_comment_count, f.hours_to_merge, f.reviewer_excerpt,
+            f.reviewer_excerpt_url, f.debrief
+     from flights f join repos r on r.id = f.repo_id
+     where f.index_ok
+     order by random() limit $1`,
+    [sample],
+  );
+  const failures: number[] = [];
+  console.log(`  spot check: ${rows.length} randomly sampled indexed flights`);
+  for (const row of rows) {
+    const reasons: string[] = [];
+    const record: DebriefRecord = {
+      ...row,
+      agent_label: AGENT_LABELS[row.agent] ?? row.agent,
+      additions: n(row.additions),
+      deletions: n(row.deletions),
+      files_changed: n(row.files_changed),
+      commits: n(row.commits),
+      review_count: n(row.review_count),
+      change_requests: n(row.change_requests),
+      review_comment_count: n(row.review_comment_count),
+      hours_to_merge: n(row.hours_to_merge),
+    };
+    const verdict = validateDebrief(row.debrief, record);
+    if (!verdict.ok) reasons.push(...verdict.reasons);
+    if (row.reviewer_excerpt) {
+      if (row.reviewer_excerpt.trim().split(/\s+/).length > 25) reasons.push('excerpt over 25 words');
+      if (row.reviewer_excerpt_url && !/^https:\/\/github\.com\//.test(row.reviewer_excerpt_url)) {
+        reasons.push('excerpt URL not github.com');
+      }
+    }
+    for (const field of ['additions', 'deletions', 'files_changed', 'commits'] as const) {
+      const v = record[field];
+      if (v !== null && v < 0) reasons.push(`${field} negative`);
+    }
+    const url = `https://agentriders.com/logs/${row.owner}/${row.name}/${row.number}/`;
+    if (reasons.length > 0) {
+      failures.push(row.id);
+      console.log(`  FAIL ${url} — ${reasons.join('; ')}`);
+    } else {
+      console.log(`  ok   ${url}`);
+    }
+  }
+  return failures;
+}
+
+async function renderOgCards(db: Db, limit: number): Promise<number> {
+  await ensureBucket();
+  const rows = await db.query<{
+    id: number; title: string; owner: string; name: string; full_name: string;
+    number: number; agent: string; outcome: string | null; additions: number | null;
+    deletions: number | null; files_changed: number | null; hours_to_merge: number | null;
+  }>(
+    `select f.id, f.title, r.owner, r.name, r.full_name, f.number, f.agent, f.outcome,
+            f.additions, f.deletions, f.files_changed, f.hours_to_merge
+     from flights f join repos r on r.id = f.repo_id
+     where f.index_ok and f.og_generated_at is null
+     order by f.opened_at desc nulls last
+     limit $1`,
+    [limit],
+  );
+  let rendered = 0;
+  for (const row of rows) {
+    try {
+      const png = await flightCard({
+        title: row.title,
+        repo: row.full_name,
+        number: Number(row.number),
+        agentLabel: AGENT_LABELS[row.agent] ?? row.agent,
+        outcome: row.outcome,
+        additions: n(row.additions),
+        deletions: n(row.deletions),
+        filesChanged: n(row.files_changed),
+        hoursToMerge: n(row.hours_to_merge),
+      });
+      await uploadPng(`flights/${row.owner}/${row.name}/${row.number}.png`, png);
+      await db.query('update flights set og_generated_at = now() where id = $1', [row.id]);
+      rendered++;
+      if (rendered % 200 === 0) console.log(`  og cards ${rendered}/${rows.length}`);
+    } catch (error) {
+      console.log(`  og card failed for flight ${row.id}: ${String(error).slice(0, 200)}`);
+    }
+  }
+  return rendered;
+}
+
+function n(v: unknown): number | null {
+  if (v === null || v === undefined) return null;
+  const x = Number(v);
+  return Number.isFinite(x) ? x : null;
+}
