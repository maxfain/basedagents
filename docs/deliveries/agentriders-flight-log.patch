@@ -0,0 +1,54 @@
+// Manage one claimed flight: POST { visibility: "public" | "hidden" } or
+// POST { note: "..." } (≤280 chars — "What I'd do differently", the only
+// rider-written text on a flight page; empty string clears it). Only the
+// claiming rider can change either; the RPCs enforce it again in SQL.
+
+import type { APIRoute } from 'astro';
+import { rateLimit } from '../../../lib/ratelimit';
+import { flightlogConfigured, rpc } from '../../../lib/flightlog';
+
+export const prerender = false;
+
+const json = (status: number, body: unknown) =>
+  new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json' } });
+
+export const POST: APIRoute = async ({ locals, params, request }) => {
+  const rider = locals.rider;
+  if (!rider) return json(401, { error: 'Sign in first.' });
+  const { env } = locals.runtime;
+  if (!flightlogConfigured(env)) return json(503, { error: 'The flight log is not configured yet.' });
+  const flightId = Number(params.id);
+  if (!Number.isInteger(flightId) || flightId < 1) return json(400, { error: 'Bad flight id.' });
+  if (!(await rateLimit(env.RATE, `flmanage:${rider.id}`, 60, 3600))) {
+    return json(429, { error: 'Too many changes. Try again in an hour.' });
+  }
+
+  let body: { visibility?: string; note?: string };
+  try {
+    body = (await request.json()) as typeof body;
+  } catch {
+    return json(400, { error: 'Send JSON: { "visibility": "hidden" } or { "note": "..." }' });
+  }
+
+  if (body.visibility !== undefined) {
+    if (body.visibility !== 'public' && body.visibility !== 'hidden') {
+      return json(400, { error: 'visibility must be "public" or "hidden".' });
+    }
+    const result = await rpc<{ ok: boolean; error?: string }>(env, 'set_claim_visibility', {
+      p_flight_id: flightId, p_rider_id: rider.id, p_visibility: body.visibility,
+    });
+    if (!result?.ok) return json(403, { error: 'Not your flight.' });
+    return json(200, { ok: true, visibility: body.visibility });
+  }
+
+  if (body.note !== undefined) {
+    const note = String(body.note).trim().slice(0, 280);
+    const result = await rpc<{ ok: boolean; error?: string }>(env, 'set_claim_note', {
+      p_flight_id: flightId, p_rider_id: rider.id, p_note: note,
+    });
+    if (!result?.ok) return json(403, { error: 'Not your flight.' });
+    return json(200, { ok: true, note: note || null });
+  }
+
+  return json(400, { error: 'Nothing to change.' });
+};
diff --git a/src/pages/api/flights/claim.ts b/src/pages/api/flights/claim.ts
new file mode 100644
index 0000000..6bb667c
--- /dev/null
+++ b/src/pages/api/flights/claim.ts
@@ -0,0 +1,100 @@
+// Claim a corpus flight (docs/flight-log-corpus.md). Ownership is proven by
+// GitHub sign-in alone: the session rider's GitHub identity must equal the
+// flight author's github_user_id — checked again inside the claim_flight RPC.
+// POST {owner, repo, number} claims one; POST {all: true} claims every
+// unclaimed flight by the same account ("We found N more flights of yours").
+
+import type { APIRoute } from 'astro';
+import { rateLimit } from '../../../lib/ratelimit';
+import { recomputeRank } from '../../../lib/ranks';
+import {
+  flightlogConfigured, githubIdentityOf, rpc, validOwner, validRepoName,
+} from '../../../lib/flightlog';
+
+export const prerender = false;
+
+const json = (status: number, body: unknown) =>
+  new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json' } });
+
+/** Resync the rider's claimed-flight mirror in D1 and recompute their rank. */
+async function syncClaimsAndRank(
+  env: App.Locals['runtime']['env'],
+  riderId: string,
+): Promise<number> {
+  const mine = await rpc<{ total: number }>(env, 'rider_flights', { p_rider_id: riderId });
+  const claimed = Number(mine?.total ?? 0);
+  try {
+    await env.DB.prepare(
+      `INSERT INTO rider_claimed_flights (rider_id, claimed, updated_at) VALUES (?, ?, ?)
+       ON CONFLICT (rider_id) DO UPDATE SET claimed = excluded.claimed, updated_at = excluded.updated_at`,
+    ).bind(riderId, claimed, new Date().toISOString()).run();
+    await recomputeRank(env.DB, riderId, 'system', 'flight_claimed');
+  } catch {
+    // Pre-0003 database: the claim itself stands; ranks catch up after the
+    // migration via /api/cron/flightlog.
+  }
+  return claimed;
+}
+
+export const POST: APIRoute = async ({ locals, request }) => {
+  const rider = locals.rider;
+  if (!rider) return json(401, { error: 'Sign in first.' });
+  const { env } = locals.runtime;
+  if (!flightlogConfigured(env)) return json(503, { error: 'The flight log is not configured yet.' });
+  if (!(await rateLimit(env.RATE, `flclaim:${rider.id}`, 30, 3600))) {
+    return json(429, { error: 'Too many attempts. Try again in an hour.' });
+  }
+
+  const githubId = await githubIdentityOf(env.DB, rider.id);
+  if (githubId === null) {
+    return json(403, { error: 'Claiming needs a GitHub sign-in — your account has no GitHub identity.' });
+  }
+
+  let body: { owner?: string; repo?: string; number?: number; all?: boolean };
+  try {
+    body = (await request.json()) as typeof body;
+  } catch {
+    return json(400, { error: 'Send JSON: { "owner": "...", "repo": "...", "number": 123 } or { "all": true }' });
+  }
+
+  if (body.all === true) {
+    const result = await rpc<{ ok: boolean; claimed: number }>(env, 'claim_all', {
+      p_rider_id: rider.id,
+      p_rider_handle: rider.handle,
+      p_github_user_id: githubId,
+    });
+    const claimedTotal = await syncClaimsAndRank(env, rider.id);
+    return json(200, { ok: true, claimed: result?.claimed ?? 0, total: claimedTotal });
+  }
+
+  const owner = (body.owner ?? '').trim();
+  const repo = (body.repo ?? '').trim();
+  const number = Number(body.number);
+  if (!validOwner(owner) || !validRepoName(repo) || !Number.isInteger(number) || number < 1) {
+    return json(400, { error: 'That does not name a flight.' });
+  }
+  const flight = await rpc<{ flight: { id: number } }>(env, 'flight_page', {
+    p_owner: owner, p_repo: repo, p_number: number,
+  });
+  if (!flight?.flight?.id) return json(404, { error: 'No such flight.' });
+
+  const result = await rpc<{ ok: boolean; error?: string; already?: boolean }>(env, 'claim_flight', {
+    p_flight_id: flight.flight.id,
+    p_rider_id: rider.id,
+    p_rider_handle: rider.handle,
+    p_github_user_id: githubId,
+  });
+  if (!result?.ok) {
+    const message =
+      result?.error === 'not_author'
+        ? 'Not your flight — the PR was opened by a different GitHub account.'
+        : result?.error === 'already_claimed'
+          ? 'This flight is already claimed.'
+          : 'Claim failed.';
+    return json(result?.error === 'not_author' ? 403 : 409, { error: message });
+  }
+
+  await syncClaimsAndRank(env, rider.id);
+  const claimable = await rpc<{ count: number }>(env, 'claimable_for', { p_github_user_id: githubId });
+  return json(200, { ok: true, already: result.already ?? false, claimable: Number(claimable?.count ?? 0) });
+};
diff --git a/src/pages/api/flights/mine.ts b/src/pages/api/flights/mine.ts
new file mode 100644
index 0000000..032205e
--- /dev/null
+++ b/src/pages/api/flights/mine.ts
@@ -0,0 +1,34 @@
+// The signed-in rider's corpus flights: claimed ones (with visibility and
+// note) plus how many unclaimed flights their GitHub account still has.
+// Powers /me/flights/.
+
+import type { APIRoute } from 'astro';
+import { flightlogConfigured, githubIdentityOf, rpc, type RiderFlights } from '../../../lib/flightlog';
+
+export const prerender = false;
+
+const json = (status: number, body: unknown) =>
+  new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json' } });
+
+export const GET: APIRoute = async ({ locals }) => {
+  const rider = locals.rider;
+  if (!rider) return json(401, { error: 'Sign in first.' });
+  const { env } = locals.runtime;
+  if (!flightlogConfigured(env)) return json(200, { configured: false, flights: [], total: 0, claimable: 0 });
+
+  const mine = await rpc<RiderFlights>(env, 'rider_flights', { p_rider_id: rider.id });
+  const githubId = await githubIdentityOf(env.DB, rider.id);
+  const claimable = githubId === null
+    ? { count: 0, sample: [] }
+    : await rpc<{ count: number; sample: unknown[] }>(env, 'claimable_for', { p_github_user_id: githubId });
+
+  return json(200, {
+    configured: true,
+    total: Number(mine?.total ?? 0),
+    public: Number(mine?.public ?? 0),
+    flights: mine?.flights ?? [],
+    claimable: Number(claimable?.count ?? 0),
+    claimableSample: claimable?.sample ?? [],
+    hasGithub: githubId !== null,
+  });
+};
diff --git a/src/pages/api/flights/opt-out.ts b/src/pages/api/flights/opt-out.ts
new file mode 100644
index 0000000..a516d17
--- /dev/null
+++ b/src/pages/api/flights/opt-out.ts
@@ -0,0 +1,43 @@
+// Author opt-out (docs/flight-log-corpus.md, Consent): sign in with GitHub,
+// one button, done. Sets authors.opted_out in the corpus — every flight by
+// that account leaves rendering, JSON, sitemaps and aggregates, and its
+// pages answer 410 Gone. The row stays so the pipeline never re-creates it.
+// POST { optedOut: true | false } — reversible by the same proof.
+
+import type { APIRoute } from 'astro';
+import { rateLimit } from '../../../lib/ratelimit';
+import { flightlogConfigured, githubIdentityOf, rpc } from '../../../lib/flightlog';
+
+export const prerender = false;
+
+const json = (status: number, body: unknown) =>
+  new Response(JSON.stringify(body), { status, headers: { 'Content-Type': 'application/json' } });
+
+export const POST: APIRoute = async ({ locals, request }) => {
+  const rider = locals.rider;
+  if (!rider) return json(401, { error: 'Sign in first.' });
+  const { env } = locals.runtime;
+  if (!flightlogConfigured(env)) return json(503, { error: 'The flight log is not configured yet.' });
+  if (!(await rateLimit(env.RATE, `floptout:${rider.id}`, 10, 3600))) {
+    return json(429, { error: 'Too many attempts. Try again in an hour.' });
+  }
+  const githubId = await githubIdentityOf(env.DB, rider.id);
+  if (githubId === null) {
+    return json(403, { error: 'Opting out needs a GitHub sign-in, so it only ever covers your own account.' });
+  }
+
+  let optedOut = true;
+  try {
+    const body = (await request.json()) as { optedOut?: boolean };
+    optedOut = body.optedOut !== false;
+  } catch {
+    /* default: opt out */
+  }
+
+  const result = await rpc<{ ok: boolean }>(env, 'opt_out_author', {
+    p_github_user_id: githubId,
+    p_opted_out: optedOut,
+  });
+  if (!result?.ok) return json(500, { error: 'Opt-out failed — email hello@agentriders.com and we will do it by hand.' });
+  return json(200, { ok: true, optedOut });
+};
