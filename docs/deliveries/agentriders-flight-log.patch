diff --git a/pipeline/src/jobs/repo-metadata.ts b/pipeline/src/jobs/repo-metadata.ts
new file mode 100644
index 0000000..5223edb
--- /dev/null
+++ b/pipeline/src/jobs/repo-metadata.ts
@@ -0,0 +1,81 @@
+// Repo metadata through GraphQL, 50 repos per query by alias (brief, step 3).
+// Backfill mode fills repos that have flights but no fetched_at; weekly mode
+// (onlyIndexed) refreshes repos that currently have indexed flights.
+
+import type { Db } from '../db.ts';
+import { GraphqlClient, buildRepoBatchQuery } from '../github-graphql.ts';
+import { required } from '../env.ts';
+import { startRun, finishRun } from '../runlog.ts';
+
+type RepoRow = { id: number; owner: string; name: string };
+
+export async function repoMetadata(
+  db: Db,
+  opts: { limit?: number; onlyIndexed?: boolean; client?: GraphqlClient } = {},
+): Promise<void> {
+  const run = await startRun(db, opts.onlyIndexed ? 'refresh-repos' : 'repo-metadata');
+  const client = opts.client ?? new GraphqlClient({ token: required('FLIGHTLOG_GITHUB_TOKEN') });
+  let updated = 0;
+  let errors = 0;
+  let errorSample: string | undefined;
+  try {
+    const repos = await db.query<RepoRow>(
+      opts.onlyIndexed
+        ? `select r.id, r.owner, r.name from repos r
+           where r.excluded is not true
+             and exists (select 1 from flights f where f.repo_id = r.id and f.index_ok)
+           order by r.id limit $1`
+        : `select r.id, r.owner, r.name from repos r
+           where r.fetched_at is null and r.excluded is not true
+             and exists (select 1 from flights f where f.repo_id = r.id)
+           order by r.id limit $1`,
+      [opts.limit ?? 5000],
+    );
+    for (let i = 0; i < repos.length; i += 50) {
+      const batch = repos.slice(i, i + 50);
+      const result = await client.request(buildRepoBatchQuery(batch));
+      for (let j = 0; j < batch.length; j++) {
+        const node = result.data?.[`r${j}`] as {
+          databaseId: number | null;
+          stargazerCount: number;
+          isFork: boolean;
+          primaryLanguage: { name: string } | null;
+          licenseInfo: { spdxId: string } | null;
+        } | null;
+        if (!node) {
+          errors++;
+          errorSample ??= (result.errors ?? []).find((e) => e.path?.[0] === `r${j}`)?.message;
+          // Gone repos still get a fetched_at so they stop re-queueing.
+          await db.query('update repos set fetched_at = now() where id = $1', [batch[j].id]);
+          continue;
+        }
+        await db.query(
+          `update repos set github_repo_id = coalesce($2, github_repo_id), stars = $3,
+             primary_language = $4, license = $5, is_fork = $6, fetched_at = now()
+           where id = $1`,
+          [
+            batch[j].id,
+            node.databaseId,
+            node.stargazerCount,
+            node.primaryLanguage?.name ?? null,
+            node.licenseInfo?.spdxId ?? null,
+            node.isFork,
+          ],
+        );
+        updated++;
+      }
+      console.log(`  repo metadata ${Math.min(i + 50, repos.length)}/${repos.length}`);
+    }
+    await finishRun(db, run, {
+      ok: true,
+      rowsIn: repos.length,
+      rowsOut: updated,
+      errors,
+      errorSample,
+      meta: { graphqlRemaining: client.lastRemaining },
+    });
+  } catch (error) {
+    await finishRun(db, run, { ok: false, rowsOut: updated, errors: errors + 1, errorSample: String(error) });
+    throw error;
+  }
+}
diff --git a/pipeline/src/jobs/rider-cards.ts b/pipeline/src/jobs/rider-cards.ts
new file mode 100644
index 0000000..8639ffb
--- /dev/null
+++ b/pipeline/src/jobs/rider-cards.ts
@@ -0,0 +1,80 @@
+// Rider share cards (brief, Claim flow step 4): handle, rank, flights, merge
+// rate, burns survived, agents flown. Stats come from claims⋈flights in
+// Postgres; the rank is public information read from the site's profile JSON
+// (D1 stays the system of record for people). Runs nightly after claims.
+
+import type { Db } from '../db.ts';
+import { AGENT_LABELS } from '../agents.ts';
+import { riderCard } from '../og.ts';
+import { ensureBucket, uploadPng } from '../storage.ts';
+import { optional } from '../env.ts';
+import { startRun, finishRun } from '../runlog.ts';
+
+type RiderStats = {
+  rider_id: string;
+  handle: string;
+  flights: number;
+  merged: number;
+  decided: number;
+  burns: number;
+  agents: string[];
+};
+
+export async function riderCards(db: Db): Promise<void> {
+  const run = await startRun(db, 'rider-cards');
+  const site = optional('SITE_ORIGIN', 'https://agentriders.com').replace(/\/$/, '');
+  let rendered = 0;
+  let errors = 0;
+  let errorSample: string | undefined;
+  try {
+    await ensureBucket();
+    const riders = await db.query<RiderStats>(
+      `select c.rider_id, max(c.rider_handle) as handle,
+              count(*)::integer as flights,
+              count(*) filter (where f.state = 'merged')::integer as merged,
+              count(*) filter (where f.state <> 'open')::integer as decided,
+              count(*) filter (where f.outcome = 'burn')::integer as burns,
+              array_agg(distinct f.agent) as agents
+       from claims c join flights f on f.id = c.flight_id
+       group by c.rider_id`,
+    );
+    for (const r of riders) {
+      try {
+        // Rank from the public profile JSON; a miss renders the card unranked.
+        let rank: string | null = null;
+        try {
+          const res = await fetch(`${site}/api/public/rider/${r.handle}.json`, {
+            headers: { Accept: 'application/json' },
+            signal: AbortSignal.timeout(8000),
+          });
+          if (res.ok) rank = ((await res.json()) as { rank?: string | null }).rank ?? null;
+        } catch {
+          /* unranked card */
+        }
+        const agents = (Array.isArray(r.agents) ? r.agents : parsePgArray(String(r.agents)))
+          .map((a) => AGENT_LABELS[a] ?? a);
+        const png = await riderCard({
+          handle: r.handle,
+          rank,
+          flights: Number(r.flights),
+          mergeRate: Number(r.decided) > 0 ? Number(r.merged) / Number(r.decided) : null,
+          burnsSurvived: Number(r.burns),
+          agents,
+        });
+        await uploadPng(`riders/${r.handle}.png`, png);
+        rendered++;
+      } catch (error) {
+        errors++;
+        errorSample ??= String(error);
+      }
+    }
+    await finishRun(db, run, { ok: true, rowsIn: riders.length, rowsOut: rendered, errors, errorSample });
+  } catch (error) {
+    await finishRun(db, run, { ok: false, rowsOut: rendered, errors: errors + 1, errorSample: String(error) });
+    throw error;
+  }
+}
+
+function parsePgArray(value: string): string[] {
+  return value.replace(/^\{|\}$/g, '').split(',').filter(Boolean);
+}
diff --git a/pipeline/src/og.ts b/pipeline/src/og.ts
new file mode 100644
index 0000000..5389312
--- /dev/null
+++ b/pipeline/src/og.ts
@@ -0,0 +1,188 @@
+// OG cards (1200×630) in the site's brand system — the palette, the eye mark
+// and the Fraunces/JetBrains Mono pairing from scripts/generate-og.mjs.
+// Rendered by the pipeline (satori + resvg don't fit Pages Functions) and
+// uploaded to Supabase Storage; a page only points at a card after
+// og_generated_at is stamped, so og:image never 404s.
+
+import { readFile } from 'node:fs/promises';
+import satori from 'satori';
+import { Resvg } from '@resvg/resvg-js';
+
+const ink = '#16130F';
+const bone = '#F2EBDD';
+const ember = '#E4572E';
+const caption = '#C9BAA7';
+const moss = '#7A8450';
+
+const markSvg = `<svg viewBox="0 0 30 30" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2 15C7 6 23 6 28 15C23 24 7 24 2 15Z" stroke="${bone}" stroke-width="2" stroke-linejoin="round"/><path d="M15 8.5C12.6 12 12.6 18 15 21.5C17.4 18 17.4 12 15 8.5Z" fill="${ember}"/></svg>`;
+const markUri = `data:image/svg+xml;base64,${Buffer.from(markSvg).toString('base64')}`;
+
+type Node = { type: string; props: Record<string, unknown> };
+const el = (type: string, style: Record<string, unknown>, children?: unknown): Node => ({
+  type,
+  props: { style: { display: 'flex', ...style }, children },
+});
+
+let fontsPromise: Promise<{ name: string; data: Buffer; weight: number; style: 'normal' }[]> | null = null;
+function fonts() {
+  fontsPromise ??= Promise.all([
+    readFile(new URL('../node_modules/@fontsource/fraunces/files/fraunces-latin-600-normal.woff', import.meta.url)),
+    readFile(new URL('../node_modules/@fontsource/jetbrains-mono/files/jetbrains-mono-latin-500-normal.woff', import.meta.url)),
+  ]).then(([fraunces, mono]) => [
+    { name: 'Fraunces', data: fraunces, weight: 600, style: 'normal' as const },
+    { name: 'JetBrains Mono', data: mono, weight: 500, style: 'normal' as const },
+  ]);
+  return fontsPromise;
+}
+
+export const OUTCOME_LABELS: Record<string, string> = {
+  merged_clean: 'MERGED CLEAN',
+  merged_after_rework: 'MERGED AFTER REWORK',
+  burn: 'BURN',
+  abandoned: 'ABANDONED',
+  open: 'OPEN',
+  stale: 'STALE',
+};
+
+const OUTCOME_COLORS: Record<string, string> = {
+  merged_clean: moss,
+  merged_after_rework: moss,
+  burn: ember,
+  abandoned: caption,
+  open: caption,
+  stale: caption,
+};
+
+async function render(tree: Node): Promise<Buffer> {
+  const svg = await satori(tree as never, { width: 1200, height: 630, fonts: await fonts() });
+  return Buffer.from(new Resvg(svg, { fitTo: { mode: 'width', value: 1200 } }).render().asPng());
+}
+
+const header = el('div', { alignItems: 'center', gap: '14px' }, [
+  { type: 'img', props: { src: markUri, width: 44, height: 44 } },
+  el('div', { fontFamily: 'Fraunces', fontSize: '28px', color: bone }, 'AgentRiders — Flight Log'),
+]);
+
+function footer(left: string) {
+  return el(
+    'div',
+    { justifyContent: 'space-between', fontFamily: 'JetBrains Mono', fontSize: '15px', color: caption },
+    [el('div', {}, left), el('div', { color: ember }, 'agentriders.com')],
+  );
+}
+
+export type FlightCard = {
+  title: string;
+  repo: string;
+  number: number;
+  agentLabel: string;
+  outcome: string | null;
+  additions: number | null;
+  deletions: number | null;
+  filesChanged: number | null;
+  hoursToMerge: number | null;
+};
+
+export async function flightCard(f: FlightCard): Promise<Buffer> {
+  const stats: string[] = [];
+  if (f.additions !== null && f.deletions !== null) stats.push(`+${f.additions} −${f.deletions}`);
+  if (f.filesChanged !== null) stats.push(`${f.filesChanged} ${f.filesChanged === 1 ? 'file' : 'files'}`);
+  if (f.hoursToMerge !== null) stats.push(`${Number(f.hoursToMerge) < 48 ? `${Math.round(Number(f.hoursToMerge))}h` : `${Math.round(Number(f.hoursToMerge) / 24)}d`} to merge`);
+  const title = f.title.length > 90 ? `${f.title.slice(0, 89)}…` : f.title;
+  const outcome = f.outcome ?? 'open';
+  const tree = el(
+    'div',
+    {
+      width: '100%',
+      height: '100%',
+      flexDirection: 'column',
+      justifyContent: 'space-between',
+      backgroundColor: ink,
+      padding: '54px 64px',
+    },
+    [
+      header,
+      el('div', { flexDirection: 'column', gap: '26px' }, [
+        el('div', { gap: '14px', alignItems: 'center' }, [
+          el(
+            'div',
+            {
+              fontFamily: 'JetBrains Mono',
+              fontSize: '17px',
+              color: ink,
+              backgroundColor: OUTCOME_COLORS[outcome] ?? caption,
+              padding: '6px 14px',
+              borderRadius: '4px',
+            },
+            OUTCOME_LABELS[outcome] ?? outcome.toUpperCase(),
+          ),
+          el('div', { fontFamily: 'JetBrains Mono', fontSize: '17px', color: caption }, `${f.agentLabel} flight`),
+        ]),
+        el(
+          'div',
+          {
+            fontFamily: 'Fraunces',
+            fontSize: title.length > 60 ? '46px' : '58px',
+            lineHeight: 1.06,
+            letterSpacing: '-0.02em',
+            color: bone,
+            maxWidth: '1050px',
+          },
+          title,
+        ),
+        el('div', { fontFamily: 'JetBrains Mono', fontSize: '21px', color: caption, gap: '28px' },
+          stats.map((s) => el('div', {}, s))),
+      ]),
+      footer(`${f.repo}#${f.number}`),
+    ],
+  );
+  return render(tree);
+}
+
+export type RiderCard = {
+  handle: string;
+  rank: string | null;
+  flights: number;
+  mergeRate: number | null; // 0..1
+  burnsSurvived: number;
+  agents: string[];
+};
+
+export async function riderCard(r: RiderCard): Promise<Buffer> {
+  const stats = [
+    `${r.flights} ${r.flights === 1 ? 'flight' : 'flights'}`,
+    r.mergeRate !== null ? `${Math.round(r.mergeRate * 100)}% merged` : null,
+    `${r.burnsSurvived} ${r.burnsSurvived === 1 ? 'burn' : 'burns'} survived`,
+  ].filter((s): s is string => s !== null);
+  const tree = el(
+    'div',
+    {
+      width: '100%',
+      height: '100%',
+      flexDirection: 'column',
+      justifyContent: 'space-between',
+      backgroundColor: ink,
+      padding: '54px 64px',
+    },
+    [
+      header,
+      el('div', { flexDirection: 'column', gap: '20px' }, [
+        el('div', { fontFamily: 'JetBrains Mono', fontSize: '19px', color: ember },
+          (r.rank ?? 'rider').toUpperCase()),
+        el(
+          'div',
+          { fontFamily: 'Fraunces', fontSize: '84px', lineHeight: 1, letterSpacing: '-0.02em', color: bone },
+          `@${r.handle}`,
+        ),
+        el('div', { fontFamily: 'JetBrains Mono', fontSize: '22px', color: caption, gap: '28px' },
+          stats.map((s) => el('div', {}, s))),
+        r.agents.length > 0
+          ? el('div', { fontFamily: 'JetBrains Mono', fontSize: '17px', color: caption },
+              `flies ${r.agents.slice(0, 4).join(' · ')}`)
+          : el('div', {}, ''),
+      ]),
+      footer(`riders/${r.handle}`),
+    ],
+  );
+  return render(tree);
+}
diff --git a/pipeline/src/parquet.ts b/pipeline/src/parquet.ts
new file mode 100644
index 0000000..d6c9c2a
--- /dev/null
+++ b/pipeline/src/parquet.ts
@@ -0,0 +1,47 @@
+// Thin wrappers over hyparquet. AIDev files are snappy-compressed (built-in)
+// single-row-group parquet; int64 columns arrive as BigInt. The full 933k-row
+// body column reads in one pass at ~1.4 GB RSS, so the backfill runs with
+// --max-old-space-size=6144 (pipeline/README.md) rather than a streaming
+// contortion here.
+
+import { asyncBufferFromFile, parquetMetadataAsync, parquetReadObjects } from 'hyparquet';
+
+export async function rowCount(path: string): Promise<number> {
+  const file = await asyncBufferFromFile(path);
+  const md = await parquetMetadataAsync(file);
+  return Number(md.num_rows);
+}
+
+export async function readColumns<T = Record<string, unknown>>(
+  path: string,
+  columns: string[],
+  range?: { rowStart?: number; rowEnd?: number },
+): Promise<T[]> {
+  const file = await asyncBufferFromFile(path);
+  return (await parquetReadObjects({
+    file,
+    columns,
+    rowStart: range?.rowStart,
+    rowEnd: range?.rowEnd,
+  })) as T[];
+}
+
+/** BigInt/number/string → number (GitHub ids are < 2^53). */
+export function num(v: unknown): number | null {
+  if (v === null || v === undefined) return null;
+  const n = typeof v === 'bigint' ? Number(v) : Number(v);
+  return Number.isFinite(n) ? n : null;
+}
+
+export function str(v: unknown): string | null {
+  if (v === null || v === undefined) return null;
+  const s = String(v);
+  return s.length > 0 ? s : null;
+}
+
+/** AIDev timestamps are ISO strings; empty/invalid → null. */
+export function iso(v: unknown): string | null {
+  const s = str(v);
+  if (!s) return null;
+  return Number.isFinite(Date.parse(s)) ? s : null;
+}
diff --git a/pipeline/src/run.ts b/pipeline/src/run.ts
new file mode 100644
index 0000000..e52cb23
--- /dev/null
+++ b/pipeline/src/run.ts
@@ -0,0 +1,139 @@
+// Job dispatcher: node pipeline/src/run.ts <job> [flags]
+// Every job is idempotent and re-runnable; each writes a pipeline_runs row.
+
+import { parseArgs } from 'node:util';
+import { fileURLToPath } from 'node:url';
+import { dirname, join } from 'node:path';
+import { connect, migrate } from './db.ts';
+
+const HERE = dirname(fileURLToPath(import.meta.url));
+
+const JOBS: Record<string, string> = {
+  migrate: 'Apply pipeline/migrations/*.sql',
+  'download-aidev': 'Download the pinned AIDev revision into --dir',
+  'load-aidev': 'Backfill flights from AIDev parquet in --dir (core + pop)',
+  'repo-metadata': 'GraphQL stars/language/license/fork for repos with flights',
+  discover: 'GH Archive (BigQuery) discovery for --date (default: yesterday)',
+  enrich: 'GraphQL enrichment of candidates and state changes',
+  classify: 'Deterministic outcome classification',
+  debrief: 'LLM debriefs for gated flights (validated, versioned)',
+  publish: 'index_ok, aggregates refresh, OG cards, spot check',
+  'refresh-open': 'Nightly re-enrichment of open flights',
+  'refresh-repos': 'Weekly repo metadata refresh for repos with indexed flights',
+  'rider-cards': 'Render rider share cards for riders with claims',
+};
+
+function usage(): never {
+  console.log('usage: node pipeline/src/run.ts <job> [flags]\n');
+  for (const [job, help] of Object.entries(JOBS)) console.log(`  ${job.padEnd(15)} ${help}`);
+  process.exit(2);
+}
+
+const { positionals, values } = parseArgs({
+  allowPositionals: true,
+  options: {
+    dir: { type: 'string' },
+    revision: { type: 'string', default: 'v3' },
+    sample: { type: 'string' },
+    date: { type: 'string' },
+    'skip-core': { type: 'boolean', default: false },
+    'skip-pop': { type: 'boolean', default: false },
+    limit: { type: 'string' },
+    'dry-run': { type: 'boolean', default: false },
+  },
+});
+
+const job = positionals[0];
+if (!job || !(job in JOBS)) usage();
+
+if (job === 'download-aidev') {
+  const { downloadAidev } = await import('./hf.ts');
+  await downloadAidev(values.dir ?? 'data/aidev', values.revision);
+  process.exit(0);
+}
+
+// Concise failures: the message and the SQL error position, not a bundled
+// driver's whole stack.
+process.on('uncaughtException', (error: Error & { position?: string }) => {
+  console.error(`FATAL: ${error.message}${error.position ? ` (position ${error.position})` : ''}`);
+  process.exit(1);
+});
+process.on('unhandledRejection', (reason) => {
+  const e = reason as Error & { position?: string };
+  console.error(`FATAL: ${e?.message ?? e}${e?.position ? ` (position ${e.position})` : ''}`);
+  process.exit(1);
+});
+
+const db = await connect();
+try {
+  switch (job) {
+    case 'migrate': {
+      const files = await migrate(db, join(HERE, '..', 'migrations'));
+      console.log(`applied ${files.length} migration file(s): ${files.join(', ')}`);
+      break;
+    }
+    case 'load-aidev': {
+      const { loadAidev } = await import('./jobs/load-aidev.ts');
+      if (!values.dir) throw new Error('--dir <path to AIDev parquet> is required');
+      await loadAidev(db, {
+        dir: values.dir,
+        sample: values.sample ? Number(values.sample) : undefined,
+        skipCore: values['skip-core'],
+        skipPop: values['skip-pop'],
+      });
+      break;
+    }
+    case 'repo-metadata': {
+      const { repoMetadata } = await import('./jobs/repo-metadata.ts');
+      await repoMetadata(db, { limit: values.limit ? Number(values.limit) : undefined });
+      break;
+    }
+    case 'discover': {
+      const { discover } = await import('./jobs/discover.ts');
+      await discover(db, { date: values.date, dryRun: values['dry-run'] });
+      break;
+    }
+    case 'enrich': {
+      const { enrich } = await import('./jobs/enrich.ts');
+      await enrich(db, { limit: values.limit ? Number(values.limit) : undefined });
+      break;
+    }
+    case 'classify': {
+      const { classifyJob } = await import('./jobs/classify.ts');
+      await classifyJob(db);
+      break;
+    }
+    case 'debrief': {
+      const { debriefJob } = await import('./jobs/debrief.ts');
+      await debriefJob(db, {
+        limit: values.limit ? Number(values.limit) : undefined,
+        dryRun: values['dry-run'],
+      });
+      break;
+    }
+    case 'publish': {
+      const { publish } = await import('./jobs/publish.ts');
+      await publish(db, { skipOg: values['dry-run'] });
+      break;
+    }
+    case 'refresh-open': {
+      const { refreshOpen } = await import('./jobs/refresh-open.ts');
+      await refreshOpen(db, { limit: values.limit ? Number(values.limit) : undefined });
+      break;
+    }
+    case 'refresh-repos': {
+      const { repoMetadata } = await import('./jobs/repo-metadata.ts');
+      await repoMetadata(db, { onlyIndexed: true });
+      break;
+    }
+    case 'rider-cards': {
+      const { riderCards } = await import('./jobs/rider-cards.ts');
+      await riderCards(db);
+      break;
+    }
+    default:
+      usage();
+  }
+} finally {
+  await db.end();
+}
